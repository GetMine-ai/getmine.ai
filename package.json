{
  "name": "getmine-ai-website",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node --experimental-strip-types scripts/alias-beta-dir.mjs",
    "build:release": "pnpm assert:downloads && astro build && node --experimental-strip-types scripts/alias-beta-dir.mjs && pnpm assert:rendered",
    "preview": "astro preview",
    "check": "astro check",
    "assert:downloads": "node --experimental-strip-types scripts/assert-download-links.mjs links",
    "assert:rendered": "node --experimental-strip-types scripts/assert-download-links.mjs rendered"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "astro": "6.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}
