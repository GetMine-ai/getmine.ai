# Optional overrides for the waitlist form wiring (src/scripts/main.ts).
# Both have working production defaults baked in — you only need this file
# to point a local build at a test form or a staging API.

# Brevo form action the early-access signup posts to.
PUBLIC_WAITLIST_ENDPOINT=

# Endpoint pinged after a successful form submission (access-request tracking).
PUBLIC_REQUEST_SUBMITTED_ENDPOINT=
