---
// Shared chrome for the plain-text legal pages (privacy / terms / trust).
// Collapses the head + page-nav + footer that the three standalone HTML files
// each duplicated. Page-specific copy goes in the <slot/>.
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/legal.css';
import '../styles/visit-counting.css';
import type { SitePage } from '../scripts/siteMetricsCore';

interface Props {
  /** The name this page is counted under (src/scripts/siteMetrics.ts). Fixed at
   *  build time; a page without one is not counted. */
  page?: SitePage;
  title: string;
  description: string;
  canonical: string;
  /** Keep a page out of search results — for pages that only make sense when
   *  you arrived from somewhere specific (e.g. the post-confirmation welcome). */
  noindex?: boolean;
  /** A social image for the page; without it the page has no Open Graph tags, as today. */
  ogImage?: string;
  /** Where the back button leads and what it says. Defaults to the home page. */
  backHref?: string;
  backLabel?: string;
}

const {
  page,
  title,
  description,
  canonical,
  noindex = false,
  ogImage,
  backHref = '/',
  backLabel = 'Back to home',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#060C14">
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'}>
<link rel="canonical" href={canonical}>
{ogImage && (
  <>
    <meta property="og:type" content="article">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content={ogImage}>
  </>
)}

<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
</head>
<body data-site-page={page}>

<header class="page-nav">
  <a class="page-logo" href="/">Get<span class="logo-mine">Mine.</span><span class="logo-ai">ai</span></a>
  <a class="page-back" href={backHref}>&larr; {backLabel}</a>
</header>

<main>
  <article class="page-inner">
    <slot />
  </article>
</main>

<footer>
  &copy; 2026 GetMine Ltd. All rights reserved.
</footer>

<script>
  // The only script on these pages: it counts the visit, and lets ?count=off
  // turn visit counting off on whichever page it lands (src/scripts/siteMetrics.ts).
  import { startSiteMetrics } from '../scripts/siteMetrics';

  startSiteMetrics();
</script>

</body>
</html>
