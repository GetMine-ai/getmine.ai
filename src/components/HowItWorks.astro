<script>
  const initialiseHowItWorksMotion = () => {
    document.querySelectorAll<HTMLElement>('[data-walkthrough]').forEach((walkthrough) => {
      if (walkthrough.dataset.motionInitialised === 'true') return;
      walkthrough.dataset.motionInitialised = 'true';

      const panels = Array.from(walkthrough.querySelectorAll<HTMLElement>('[data-walkthrough-panel]'));
      const buildPanel = panels[0];
      const buildViews = Array.from(buildPanel?.querySelectorAll<HTMLElement>('[data-build-view]') ?? []);
      const prompt = buildPanel?.querySelector<HTMLElement>('[data-home-prompt]');
      const story = buildPanel?.querySelector<HTMLElement>('[data-health-story]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const promptCopy = 'What is in my vault?';
      const dwell = [9000, 5000, 5000];
      let visible = false;
      let buildPhase = 0;
      let buildTimer = 0;
      let typeTimer = 0;
      let answerTimer = 0;
      let answerResetTimer = 0;
      let watchTimer = 0;

      const clearTimers = () => {
        window.clearTimeout(buildTimer);
        window.clearInterval(typeTimer);
        window.clearTimeout(answerTimer);
        window.clearTimeout(answerResetTimer);
        window.clearTimeout(watchTimer);
      };

      const animateHome = () => {
        if (!prompt || !story) return;
        window.clearInterval(typeTimer);
        prompt.textContent = reduceMotion ? promptCopy : 'Ask Mina';
        story.classList.toggle('ready', reduceMotion);
        if (reduceMotion) return;

        let chars = 0;
        typeTimer = window.setInterval(() => {
          chars += 1;
          prompt.textContent = promptCopy.slice(0, chars);
          if (chars >= promptCopy.length) {
            window.clearInterval(typeTimer);
            story.classList.add('ready');
          }
        }, 55);
      };

      const setBuildPhase = (phase: number) => {
        buildPhase = phase;
        buildViews.forEach((view, index) => {
          const active = index === phase;
          view.classList.toggle('active', active);
          view.setAttribute('aria-hidden', String(!active));
        });
        if (phase === 0) animateHome();
      };

      const scheduleBuild = () => {
        window.clearTimeout(buildTimer);
        if (!visible || buildPanel?.hidden || reduceMotion) return;
        buildTimer = window.setTimeout(() => {
          setBuildPhase((buildPhase + 1) % buildViews.length);
          scheduleBuild();
        }, dwell[buildPhase]);
      };

      const schedulePanelMotion = () => {
        window.clearTimeout(answerTimer);
        window.clearTimeout(answerResetTimer);
        window.clearTimeout(watchTimer);

        const askPanel = panels[1];
        const watchingPanel = panels[3];
        askPanel?.classList.remove('answer-ready');
        watchingPanel?.classList.remove('watch-open');
        if (!visible || reduceMotion) {
          if (reduceMotion) {
            askPanel?.classList.add('answer-ready');
            watchingPanel?.classList.add('watch-open');
          }
          return;
        }

        if (askPanel && !askPanel.hidden) {
          answerTimer = window.setTimeout(() => askPanel.classList.add('answer-ready'), 550);
          answerResetTimer = window.setTimeout(() => {
            askPanel.classList.remove('answer-ready');
            window.setTimeout(() => askPanel.classList.add('answer-ready'), 120);
          }, 4200);
        }
        if (watchingPanel && !watchingPanel.hidden) {
          watchTimer = window.setTimeout(() => watchingPanel.classList.add('watch-open'), 2800);
        }
      };

      const sync = () => {
        if (!visible) {
          clearTimers();
          return;
        }
        if (buildPanel && !buildPanel.hidden) {
          setBuildPhase(buildPhase);
          scheduleBuild();
        } else {
          window.clearTimeout(buildTimer);
          window.clearInterval(typeTimer);
        }
        schedulePanelMotion();
      };

      const panelObserver = new MutationObserver(sync);
      panels.forEach((panel) => panelObserver.observe(panel, { attributes: true, attributeFilter: ['hidden'] }));

      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          visible = Boolean(entry?.isIntersecting);
          if (visible && buildPanel && !buildPanel.hidden) setBuildPhase(0);
          sync();
        },
        { threshold: 0.25 },
      );
      visibilityObserver.observe(walkthrough);
    });
  };

  initialiseHowItWorksMotion();
  document.addEventListener('astro:page-load', initialiseHowItWorksMotion);
</script>
