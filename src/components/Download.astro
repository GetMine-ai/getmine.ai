---
import InviteFriend from './InviteFriend.astro';

interface BuildInfo {
  url: string;
  version: string;
  sizeMB: number;
  filename: string;
  minOs: string;
  signedBy: string;
  sha256: string;
}

interface Props {
  builds: {
    mac: BuildInfo;
    windows: BuildInfo;
  };
}

const { builds } = Astro.props;

const platforms = [
  {
    key: 'mac',
    tabLabel: 'macOS',
    title: 'GetMine for macOS',
    build: builds.mac,
    trust:
      'Your Mac verifies this before installing — signed by GETMINE LTD and notarised by Apple.',
  },
  {
    key: 'windows',
    tabLabel: 'Windows',
    title: 'GetMine for Windows',
    build: builds.windows,
    trust:
      'Windows verifies this before installing — publisher verified as GETMINE LTD.',
  },
] as const;
---
<main
  class="download-page"
  data-download-module
  data-enhanced="false"
  data-platform=""
  data-detected-platform=""
>
  <script is:inline>
    (()=>{const r=document.currentScript?.closest('[data-download-module]');if(!r)return;const p=navigator.userAgentData?.platform||navigator.platform||navigator.userAgent||'',i=/Mac/i.test(p)&&navigator.maxTouchPoints>1,d=!i&&/Win/i.test(p)?'windows':!i&&/Mac/i.test(p)?'mac':'unsupported';r.dataset.platform=d;r.dataset.detectedPlatform=d;r.dataset.enhanced='true'})();
  </script>

  <div class="download-glow" aria-hidden="true"></div>
  <svg class="download-memory-line" viewBox="0 0 1600 300" aria-hidden="true">
    <path d="M0 165 C175 35 295 285 465 165 S760 35 930 165 S1225 285 1400 165 S1545 80 1600 118" />
    <circle cx="465" cy="165" r="6" />
    <circle cx="930" cy="165" r="6" />
    <circle cx="1400" cy="165" r="6" />
  </svg>
  <div class="wrap download-wrap">
    <section class="download-panel" aria-labelledby="download-title">
      <header class="download-hero">
        <p class="beta-status-pill">
          <span class="status-dot" aria-hidden="true"></span>
          Open beta · Free to download
        </p>

        <div class="hero-mark-wrap" aria-hidden="true">
          <span class="mina-ring"></span>
          <span class="mina-mark"><i>M</i><b>.</b></span>
        </div>
        <h1 id="download-title">Download GetMine</h1>
        <p class="download-lead">
          <span>Choose macOS or Windows. Your download starts with one click.</span>
        </p>
      </header>

      <div class="download-keys">
        <p class="download-key">
          <span class="key-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32">
              <rect x="5.5" y="5.5" width="21" height="16" rx="1.5"></rect>
              <path d="M12 26.5h8M16 21.5v5"></path>
            </svg>
          </span>
          <strong>Your vault lives on your computer.</strong>
        </p>
        <p class="download-key">
          <span class="key-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32">
              <path d="M17.5 5.5H26.5V14.5L15 26 6 17z"></path>
              <circle cx="21.6" cy="10.4" r="1.6"></circle>
            </svg>
          </span>
          <strong>Free during the beta, no account.</strong>
        </p>
      </div>

      <aside class="unsupported-notice" data-unsupported-notice>
        <p><strong>Sorry — the beta runs on macOS and Windows only.</strong> GetMine is a desktop
          app, because your vault lives on your own computer. There’s no phone,
          tablet or Linux version yet.
        </p>
        <p>
          On your phone right now? Take the link with you:
          <strong>getmine.ai/beta</strong>
        </p>
        <div class="notice-actions">
          <button type="button" data-copy-beta-link>Copy link</button>
          <a
            href="mailto:?subject=GetMine%20download%20link&body=https%3A%2F%2Fgetmine.ai%2Fbeta"
          >
            Email it to yourself
          </a>
        </div>
        <span class="sr-only" aria-live="polite" data-link-announcer></span>
      </aside>

      <div class="platform-panels" aria-label="Download GetMine">
        {platforms.map((platform) => {
          const available = Boolean(platform.build.url);
          return (
            <section
              id={`download-${platform.key}`}
              class="platform-panel"
              data-platform-panel={platform.key}
              data-available={String(available)}
              aria-labelledby={`download-${platform.key}-heading`}
            >
              <h2 class="sr-only" id={`download-${platform.key}-heading`}>{platform.title}</h2>
              <div class="platform-card-top">
                <div class="installer-mark" aria-hidden="true">
                  {platform.key === 'mac' ? (
                    <svg class="platform-icon platform-icon--apple" viewBox="0 0 24 24">
                      <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.09 3.13 7.5 8.33 7.21c1.26-.07 2.4.87 3.2.87.78 0 2.23-1.07 3.77-.91.64.03 2.43.26 3.58 1.94-.09.06-2.14 1.25-2.12 3.78.03 3.02 2.65 4.03 2.68 4.04-.02.07-.42 1.44-1.39 2.85ZM14.29 3.24c.81-.96 2.16-1.67 3.31-1.71.15 1.33-.39 2.68-1.17 3.64-.78.97-2.05 1.72-3.32 1.62-.17-1.3.46-2.63 1.18-3.55Z"></path>
                    </svg>
                  ) : (
                    <svg class="platform-icon platform-icon--windows" viewBox="0 0 24 24">
                      <path d="M3 4.75 10.75 3.7v7.55H3V4.75Zm9.25-1.25L21 2.25v9h-8.75V3.5ZM3 12.75h7.75v7.55L3 19.25v-6.5Zm9.25 0H21v9l-8.75-1.25v-7.75Z"></path>
                    </svg>
                  )}
                </div>
                <span class="platform-fit">
                  {platform.key === 'mac' ? 'For this Mac' : 'For this Windows PC'}
                </span>
              </div>

              <div class="installer-copy">
                {available ? (
                  <>
                    <h3>{platform.title}</h3>
                    <p>
                      {platform.build.filename}
                      {platform.build.sizeMB > 0 && ` · ${platform.build.sizeMB} MB`}
                    </p>
                  </>
                ) : (
                  <>
                    <h3>Sign up installer coming next</h3>
                    <p>Release timeline shared soon — updates here.</p>
                  </>
                )}
              </div>

              {available && (
                <div class="download-action" data-download-action>
                  <div class="download-start" data-download-start>
                    <a
                      class="download-button"
                      href={platform.build.url}
                      download={platform.build.filename}
                      data-download-link
                      data-download-platform={platform.key}
                    >
                      Download for {platform.tabLabel}
                    </a>
                  </div>

                  <div
                    class="download-confirmation"
                    data-download-confirmation
                    role="status"
                    aria-live="polite"
                  >
                    <div class="receipt-head">
                      <span class="receipt-disc" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <g class="receipt-travel">
                            <path d="M12 3v9"></path>
                            <path d="M7.6 8.4 12 12.8l4.4-4.4"></path>
                          </g>
                          <path d="M5.5 18.5h13"></path>
                        </svg>
                      </span>
                      <strong class="receipt-title">Download started</strong>
                    </div>
                    <p class="receipt-line">Your browser is bringing it in.</p>
                  </div>
                  <a
                    class="download-fallback"
                    href={platform.build.url}
                    download={platform.build.filename}
                    data-download-fallback
                  >
                    Download didn’t start? Use the direct link.
                  </a>
                </div>
              )}

              {available && (
                <div class="installer-trust">
                  <p class="quiet-meta">
                    Requires {platform.build.minOs} · Signed by {platform.build.signedBy}{platform.key === 'mac' ? ', notarised by Apple' : ''}
                  </p>
                  {platform.build.sha256 && (
                    <details class="verify-fold">
                      <summary>Verify your download</summary>
                      <p>
                        Your computer checks the signature before anything installs.
                        The careful can also compare the file's fingerprint:
                      </p>
                      <p class="checksum-line">
                        <span class="checksum-label">SHA-256</span>
                        <code class="checksum-value">{platform.build.sha256}</code>
                      </p>
                      <p><a href="/trust">How verification works</a></p>
                    </details>
                  )}
                </div>
              )}
            </section>
          );
        })}
      </div>

      <p class="download-terms">
        <span>Mina’s AI is included; heavy users will be asked to add their own API key.</span>
        <a href="/terms" target="_blank" rel="noopener">Read the beta terms</a>
      </p>

      <section class="waiting" data-waiting aria-labelledby="waiting-heading">
        <h2 id="waiting-heading">While you’re waiting</h2>
        <div class="waiting-grid">
          <div class="waiting-mina">
            <span class="mina-mark mina-mark--breathing" aria-hidden="true"><i>M</i><b>.</b></span>
            <span class="waiting-name">Mina</span>
          </div>
          <div class="waiting-messages">
            <p class="mina-bubble" data-mina-message="1">
              I’m Mina, I’ll look after your vault. It’s downloading now, about a minute.
            </p>
            {platforms.map((platform) =>
              platform.build.url ? (
                <p class="mina-bubble" data-mina-message="2" data-message-platform={platform.key}>
                  When it’s downloaded, open {platform.build.filename}.{' '}
                  {platform.key === 'mac'
                    ? 'Your Mac checks our signature before anything installs.'
                    : 'Windows checks our publisher before anything installs.'}{' '}
                  I’ll be there when it opens.
                </p>
              ) : null,
            )}
          </div>
        </div>
      </section>

      <section class="referral-card" aria-labelledby="referral-heading">
        <span class="referral-icon" aria-hidden="true">
          <svg viewBox="0 0 44 44">
            <circle cx="16" cy="13" r="6"></circle>
            <circle cx="30.5" cy="15" r="4.5"></circle>
            <path d="M4.5 36v-3.5a11.5 11.5 0 0 1 23 0V36M27.5 25.5a9 9 0 0 1 12 8.5v2"></path>
          </svg>
        </span>
        <div class="referral-copy">
          <h2 id="referral-heading">Know someone who should own their health data too?</h2>
        </div>
        <div class="invite-action">
          <InviteFriend
            variant="primary"
            placement="beta"
            instanceId="download-card"
          />
        </div>
      </section>
    </section>
  </div>
</main>

<script>
  // The site's only measurement (ruled, spec §1.6a): two anonymous first-party
  // counts — page view and download click. No identity, no cookie, no storage;
  // fire-and-forget so a failure can never affect the page. Disclosed in /privacy.
  const COUNT_ENDPOINT = 'https://api.getmine.ai/access/v1/request-submitted';
  const count = (event: string) => {
    void fetch(`${COUNT_ENDPOINT}?event=${event}`, {
      method: 'POST',
      credentials: 'omit',
      referrerPolicy: 'no-referrer',
      keepalive: true,
    }).catch(() => undefined);
  };

  const roots = document.querySelectorAll<HTMLElement>(
    '[data-download-module]:not([data-module-ready])',
  );
  if (roots.length) count('page-view');

  roots.forEach((root) => {
    root.dataset.moduleReady = 'true';
    // Mina's minute (MINION-21, 5 Sep): the second message waits until the
    // download has plausibly landed. A timer, never a claim: message 2 stays
    // conditional ("When it’s downloaded"). The fallback link is not timed: it
    // sits under the receipt from the moment the receipt appears (Sabine, 5 Sep:
    // a link that pops up while the download is working reads as an alarm).
    const SECOND_MESSAGE_AFTER_MS = 45_000;
    // Without JavaScript the section and both messages render at once (the
    // sequence is a nicety, never the content); with it, they wait for the click.
    const waiting = root.querySelector<HTMLElement>('[data-waiting]');
    if (waiting) waiting.hidden = true;
    const actions = root.querySelectorAll<HTMLElement>('[data-download-action]');
    const laterMessages = root.querySelectorAll<HTMLElement>('[data-mina-message="2"]');
    laterMessages.forEach((message) => { message.hidden = true; });

    root.querySelectorAll<HTMLAnchorElement>('[data-download-link]').forEach((link) => {
      link.addEventListener('click', () => {
        count('download-click');
        const action = link.closest<HTMLElement>('[data-download-action]');
        if (!action) return;
        // One download at a time on the page: the platform pressed last owns the
        // receipt, the dimming and Mina's second message; the other card returns
        // to its button (Codex, 5 Sep — two receipts after two clicks).
        actions.forEach((other) => { if (other !== action) delete other.dataset.started; });
        action.dataset.started = 'true';
        const first = !root.dataset.started;
        root.dataset.started = link.dataset.downloadPlatform ?? 'true';
        if (first) {
          if (waiting) waiting.hidden = false;
          window.setTimeout(() => {
            laterMessages.forEach((message) => { message.hidden = false; });
          }, SECOND_MESSAGE_AFTER_MS);
        }
      });
    });

    const copyText = async (value: string) => {
      if (!navigator.clipboard?.writeText) {
        throw new Error('Clipboard access is unavailable');
      }
      await navigator.clipboard.writeText(value);
    };

    const linkButton = root.querySelector<HTMLButtonElement>('[data-copy-beta-link]');
    const linkAnnouncer = root.querySelector<HTMLElement>('[data-link-announcer]');
    linkButton?.addEventListener('click', async () => {
      try {
        await copyText('https://getmine.ai/beta');
        linkButton.textContent = 'Copied';
        if (linkAnnouncer) linkAnnouncer.textContent = 'Download link copied';
      } catch {
        linkButton.textContent = 'Copy unavailable';
        if (linkAnnouncer) linkAnnouncer.textContent = 'Copy unavailable. Use the email link instead.';
      }
    });

  });
</script>

<style>
  .download-page {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding-top: 4.75rem;
    background: var(--navy);
  }

  .download-glow {
    position: absolute;
    top: -12rem;
    left: 50%;
    width: 55rem;
    height: 55rem;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(29 191 176 / 15%), transparent 72%);
    filter: blur(5rem);
    pointer-events: none;
  }

  .download-memory-line {
    position: absolute;
    top: 19rem;
    left: 50%;
    width: max(100%, 90rem);
    height: 18rem;
    transform: translateX(-50%);
    opacity: 0.16;
    pointer-events: none;
  }

  .download-memory-line path {
    fill: none;
    stroke: var(--teal);
    stroke-width: 2;
  }

  .download-memory-line circle {
    fill: var(--teal);
  }

  .download-wrap {
    position: relative;
    display: grid;
    gap: 3.5rem;
    padding-block: clamp(2rem, 5vw, 4.5rem) clamp(4rem, 8vw, 7rem);
  }

  .download-card {
    width: min(100%, 48rem);
    margin-inline: auto;
    padding: clamp(1.35rem, 4vw, 3.25rem);
    border: 1px solid var(--line);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background: color-mix(in srgb, var(--navy-2) 94%, transparent);
    box-shadow: 0 40px 100px -55px rgb(0 0 0 / 95%);
    text-align: center;
  }

  .mina-mark {
    display: flex;
    width: clamp(4.5rem, 9vw, 6rem);
    height: clamp(4.5rem, 9vw, 6rem);
    align-items: center;
    justify-content: center;
    margin: 1.5rem auto 0;
    border: 1px solid var(--teal-line);
    border-radius: 50%;
    background: var(--navy-2);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
  }

  /* The one Mina mark, as on Meet Mina and About: a cream, light, italic M and
     a teal, light dot on the navy disc. Every mark on this page inherits it. */
  .mina-mark i {
    color: var(--cream);
    font-style: italic;
    font-weight: 300;
  }

  .mina-mark b {
    color: var(--teal);
    font-weight: 300;
  }

  h1 {
    margin: 1rem 0 0;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.12;
    text-wrap: balance;
  }

  .download-lead {
    max-width: 39rem;
    margin: 1.25rem auto 0;
    color: var(--cream);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .unsupported-notice {
    display: none;
    margin-top: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-md);
    background: var(--teal-surface);
    text-align: left;
  }

  [data-enhanced='true'][data-detected-platform='unsupported'] .unsupported-notice {
    display: block;
  }

  .unsupported-notice[hidden] {
    display: none;
  }

  .unsupported-notice p {
    margin: 0;
    color: var(--cream);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .unsupported-notice p + p {
    margin-top: 0.75rem;
  }

  .notice-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .notice-actions button,
  .notice-actions a {
    min-height: 2.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--cream);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .platform-panels {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .platform-panel {
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-align: left;
  }

  .platform-panel[hidden] {
    display: none;
  }

  .platform-panel h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .expectations-summary {
    max-width: 40rem;
    margin: 2rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-quiet);
    text-align: left;
  }

  .expectations-summary .eyebrow {
    font-size: clamp(1rem, 1.3vw, 1.125rem);
  }

  .expectation-list {
    display: grid;
    gap: 0;
    margin-top: 0.75rem;
  }

  .expectation-list p {
    margin: 0;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line-quiet);
    color: var(--cream);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  .expectations-summary > a,
  .trust-line,
  .minimum-os {
    margin: 0;
    color: var(--cream);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .expectations-summary > a {
    display: inline-flex;
    margin-top: 0.75rem;
  }

  .expectations-summary > a,
  .trust-line a {
    width: fit-content;
    color: var(--teal);
  }

  .download-action {
    display: grid;
    min-height: 9.25rem;
    align-items: center;
    margin-top: 0.75rem;
    padding-block: 0.25rem;
  }

  .download-start,
  .download-confirmation {
    grid-area: 1 / 1;
    transition: opacity 200ms var(--ease-gm);
  }

  .download-confirmation {
    visibility: hidden;
    opacity: 0;
  }

  .download-action[data-started='true'] .download-start {
    visibility: hidden;
    opacity: 0;
  }

  .download-action[data-started='true'] .download-confirmation {
    visibility: visible;
    opacity: 1;
  }

  .download-button {
    display: flex;
    width: 100%;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--ember);
    color: var(--navy);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
  }

  .download-button--pending {
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--taupe);
  }

  .build-meta {
    margin: 0.75rem 0 0;
    color: var(--text-quiet);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-align: center;
  }

  .build-meta a {
    color: inherit;
  }

  .trust-line {
    padding-top: 1rem;
    border-top: 1px solid var(--line-quiet);
  }

  .minimum-os {
    margin-top: 0.35rem;
    color: var(--text-quiet);
    font-size: 0.8125rem;
  }

  .invite {
    position: relative;
    display: flex;
    justify-content: center;
    grid-column: 1 / -1;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-quiet);
  }

  .invite-trigger,
  .invite-panel > button {
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--cream);
    font-weight: 700;
    cursor: pointer;
  }

  .invite-panel {
    position: absolute;
    z-index: 3;
    top: calc(100% + 0.75rem);
    width: min(24rem, calc(100vw - 3rem));
    padding: 1.25rem;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-lg);
    background: var(--navy-2);
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / 90%);
    text-align: left;
  }

  .invite-panel[hidden] {
    display: none;
  }

  .invite-panel h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
  }

  .invite-panel p {
    margin: 0.5rem 0 0;
    line-height: 1.5;
  }

  .invite-panel textarea {
    width: 100%;
    margin-top: 1rem;
    resize: vertical;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--navy);
    color: var(--cream);
    font: inherit;
    line-height: 1.5;
  }

  .invite-panel > button {
    margin-top: 0.75rem;
    border-color: var(--ember);
    background: var(--ember);
    color: var(--navy);
  }

  .expectations {
    display: grid;
    gap: 2rem;
    width: min(100%, 48rem);
    margin-inline: auto;
  }

  .expectations > div > p:not(.eyebrow) {
    margin: 1rem 0 0;
    color: var(--cream);
    font-size: 1rem;
    line-height: 1.65;
  }

  .expectations ol {
    display: grid;
    gap: 0.75rem;
    margin: 1rem 0 0;
