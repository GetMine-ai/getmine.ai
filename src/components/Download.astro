---
import InviteFriend from './InviteFriend.astro';

interface BuildInfo {
  url: string;
  version: string;
  sizeMB: number;
  filename: string;
  minOs: string;
  signedBy: string;
  sha256: string;
}

interface Props {
  builds: {
    mac: BuildInfo;
    windows: BuildInfo;
  };
}

const { builds } = Astro.props;

const platforms = [
  {
    key: 'mac',
    tabLabel: 'macOS',
    title: 'GetMine for macOS',
    build: builds.mac,
    trust:
      'Your Mac verifies this before installing — signed by GETMINE LTD and notarised by Apple.',
  },
  {
    key: 'windows',
    tabLabel: 'Windows',
    title: 'GetMine for Windows',
    build: builds.windows,
    trust:
      'Windows verifies this before installing — publisher verified as GETMINE LTD.',
  },
] as const;
---
<main
  class="download-page"
  data-download-module
  data-enhanced="false"
  data-platform=""
  data-detected-platform=""
>
  <script is:inline>
    (()=>{const r=document.currentScript?.closest('[data-download-module]');if(!r)return;const p=navigator.userAgentData?.platform||navigator.platform||navigator.userAgent||'',i=/Mac/i.test(p)&&navigator.maxTouchPoints>1,d=!i&&/Win/i.test(p)?'windows':!i&&/Mac/i.test(p)?'mac':'unsupported';r.dataset.platform=d;r.dataset.detectedPlatform=d;r.dataset.enhanced='true'})();
  </script>

  <div class="download-glow" aria-hidden="true"></div>
  <svg class="download-memory-line" viewBox="0 0 1600 300" aria-hidden="true">
    <path d="M0 165 C175 35 295 285 465 165 S760 35 930 165 S1225 285 1400 165 S1545 80 1600 118" />
    <circle cx="465" cy="165" r="6" />
    <circle cx="930" cy="165" r="6" />
    <circle cx="1400" cy="165" r="6" />
  </svg>
  <div class="wrap download-wrap">
    <section class="download-panel" aria-labelledby="download-title">
      <header class="download-hero">
        <p class="beta-status-pill">
          <span class="status-dot" aria-hidden="true"></span>
          Open beta · Free to download
        </p>

        <div class="hero-mark-wrap" aria-hidden="true">
          <span class="mina-ring"></span>
          <span class="mina-mark"><i>M</i><b>.</b></span>
        </div>
        <h1 id="download-title">Download GetMine</h1>
        <p class="download-lead">
          <span>No account, no email, nothing to fill in. The download just starts.</span>
          <span>Everything else — who you are, what you agree to — happens in the app.</span>
        </p>
      </header>

      <section class="what-to-expect" aria-labelledby="what-to-expect-heading">
        <h2 id="what-to-expect-heading">What to expect</h2>

        <div class="expectation-row">
          <span class="expectation-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32">
              <rect x="5.5" y="5.5" width="21" height="16" rx="1.5"></rect>
              <path d="M12 26.5h8M16 21.5v5"></path>
            </svg>
          </span>
          <p><strong>Your vault lives on your computer.</strong> We never hold a copy.</p>
        </div>

        <div class="expectation-row">
          <span class="expectation-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32">
              <rect x="7" y="13" width="18" height="14" rx="2"></rect>
              <path d="M11 13V9a5 5 0 0 1 10 0v4"></path>
            </svg>
          </span>
          <p><strong>Free during the Beta,</strong> no account needed, Mina’s AI included; heavy users will be asked to add their own API key.</p>
        </div>

        <div class="expectation-row">
          <span class="expectation-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32">
              <path d="M16 4.5 25 8v7.25c0 5.75-3.65 10.35-9 12.25-5.35-1.9-9-6.5-9-12.25V8l9-3.5Z"></path>
            </svg>
          </span>
          <p><strong>You can leave whenever you like,</strong> and your records stay with you, readable without us.</p>
        </div>

        <a class="beta-terms-link" href="/terms" target="_blank" rel="noopener">
          Read the beta terms
        </a>
      </section>

      <aside class="unsupported-notice" data-unsupported-notice>
        <p><strong>Sorry — the beta runs on macOS and Windows only.</strong> GetMine is a desktop
          app, because your vault lives on your own computer. There’s no phone,
          tablet or Linux version yet.
        </p>
        <p>
          On your phone right now? Take the link with you:
          <strong>getmine.ai/beta</strong>
        </p>
        <div class="notice-actions">
          <button type="button" data-copy-beta-link>Copy link</button>
          <a
            href="mailto:?subject=GetMine%20download%20link&body=https%3A%2F%2Fgetmine.ai%2Fbeta"
          >
            Email it to yourself
          </a>
        </div>
        <span class="sr-only" aria-live="polite" data-link-announcer></span>
      </aside>

      <div class="platform-tabs" data-platform-tabs aria-label="Choose your computer">
        {platforms.map((platform) => (
          <button
            type="button"
            data-platform-tab={platform.key}
            aria-controls={`download-${platform.key}`}
          >
            {platform.key === 'mac' ? (
              <svg class="platform-icon platform-icon--apple" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.09 3.13 7.5 8.33 7.21c1.26-.07 2.4.87 3.2.87.78 0 2.23-1.07 3.77-.91.64.03 2.43.26 3.58 1.94-.09.06-2.14 1.25-2.12 3.78.03 3.02 2.65 4.03 2.68 4.04-.02.07-.42 1.44-1.39 2.85ZM14.29 3.24c.81-.96 2.16-1.67 3.31-1.71.15 1.33-.39 2.68-1.17 3.64-.78.97-2.05 1.72-3.32 1.62-.17-1.3.46-2.63 1.18-3.55Z"></path>
              </svg>
            ) : (
              <svg class="platform-icon platform-icon--windows" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 4.75 10.75 3.7v7.55H3V4.75Zm9.25-1.25L21 2.25v9h-8.75V3.5ZM3 12.75h7.75v7.55L3 19.25v-6.5Zm9.25 0H21v9l-8.75-1.25v-7.75Z"></path>
              </svg>
            )}
            <span>{platform.tabLabel}</span>
          </button>
        ))}
      </div>

      <div class="platform-panels">
        {platforms.map((platform) => {
          const available = Boolean(platform.build.url);
          return (
            <section
              id={`download-${platform.key}`}
              class="platform-panel"
              data-platform-panel={platform.key}
              data-available={String(available)}
              aria-labelledby={`download-${platform.key}-heading`}
            >
              <h2 class="sr-only" id={`download-${platform.key}-heading`}>{platform.title}</h2>
              <div class="installer-mark" aria-hidden="true"><span>M</span><i>.</i></div>

              <div class="installer-copy">
                {available ? (
                  <>
                    <h3>{platform.title}</h3>
                    <p>
                      {platform.build.filename}
                      {platform.build.sizeMB > 0 && ` · ${platform.build.sizeMB} MB`}
                    </p>
                  </>
                ) : (
                  <>
                    <h3>Sign up installer coming next</h3>
                    <p>Release timeline shared soon — updates here.</p>
                  </>
                )}
              </div>

              {available && (
                <div class="download-action" data-download-action>
                  <div class="download-start" data-download-start>
                    <a
                      class="download-button"
                      href={platform.build.url}
                      download={platform.build.filename}
                      data-download-link
                      data-download-platform={platform.key}
                    >
                      Download for {platform.tabLabel}
                    </a>
                  </div>

                  <div
                    class="download-confirmation"
                    data-download-confirmation
                    role="status"
                    aria-live="polite"
                  >
                    <p><strong>Your download’s running.</strong></p>
                    <p>Next: open the installer. Your computer will confirm GETMINE LTD before anything installs.</p>
                    <a href={platform.build.url} download={platform.build.filename}>
                      Download didn’t start? Use the direct link.
                    </a>
                  </div>
                </div>
              )}

              {available && (
                <div class="installer-trust">
                  <p class="trust-line">
                    {platform.trust}
                    {' '}<a href="/trust">How verification works</a>
                  </p>
                  <p class="minimum-os">Requires {platform.build.minOs}</p>
                </div>
              )}
            </section>
          );
        })}
      </div>

      <p class="privacy-line">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="5.5" y="10.5" width="13" height="10" rx="1.5"></rect>
          <path d="M8.5 10.5v-3a3.5 3.5 0 0 1 7 0v3"></path>
        </svg>
        <span>Your privacy is built in. No account required.</span>
      </p>

      <section class="next-steps" aria-labelledby="next-steps-heading">
        <h2 id="next-steps-heading">What happens next</h2>
        <p class="next-intro">From download to your private vault in four simple steps.</p>

        <ol class="timeline">
          <li>
            <span class="step-number">1</span>
            <div>
              <h3>Open the installer</h3>
              <p>Agree to the beta terms and complete the usual installation. Your computer may confirm the publisher as GETMINE LTD.</p>
              <p class="step-note">This confirmation is performed by your operating system.</p>
            </div>
          </li>
          <li>
            <span class="step-number">2</span>
            <div>
              <h3>Tell GetMine who you are</h3>
              <p>Add your name and date of birth. These stay on your computer. Your email is sent once for verification.</p>
            </div>
          </li>
          <li>
            <span class="step-number">3</span>
            <div>
              <h3>Confirm your email</h3>
              <p>Open the link we send you to confirm that it was you.</p>
            </div>
          </li>
          <li class="timeline-final">
            <span class="step-number">4</span>
            <div>
              <h3>Your vault opens</h3>
              <p>Your health. Your data. Your rules.</p>
            </div>
          </li>
        </ol>
      </section>

      <section class="referral-card" aria-labelledby="referral-heading">
        <span class="referral-icon" aria-hidden="true">
          <svg viewBox="0 0 44 44">
            <circle cx="16" cy="13" r="6"></circle>
            <circle cx="30.5" cy="15" r="4.5"></circle>
            <path d="M4.5 36v-3.5a11.5 11.5 0 0 1 23 0V36M27.5 25.5a9 9 0 0 1 12 8.5v2"></path>
          </svg>
        </span>
        <div class="referral-copy">
          <h2 id="referral-heading">Know someone who should own their health data too?</h2>
          <p>Invite them to download GetMine during the open beta.</p>
        </div>
        <div class="invite-action">
          <InviteFriend
            variant="primary"
            placement="beta"
            instanceId="download-card"
          />
        </div>
      </section>
    </section>
  </div>
</main>

<script>
  const roots = document.querySelectorAll<HTMLElement>(
    '[data-download-module]:not([data-module-ready])',
  );

  roots.forEach((root) => {
    root.dataset.moduleReady = 'true';
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-platform-tab]'),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[data-platform-panel]'),
    );
    const selectPlatform = (platform: string, focus = false) => {
      root.dataset.platform = platform;
      tabs.forEach((tab) => {
        const selected = tab.dataset.platformTab === platform;
        tab.setAttribute('aria-selected', String(selected));
        tab.setAttribute('tabindex', selected ? '0' : '-1');
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel) => {
        const selected = panel.dataset.platformPanel === platform;
        panel.hidden = !selected;
      });
    };

    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      tab.addEventListener('click', () => {
        const platform = tab.dataset.platformTab;
        if (platform) selectPlatform(platform);
      });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const next = (index + direction + tabs.length) % tabs.length;
        const platform = tabs[next]?.dataset.platformTab;
        if (platform) selectPlatform(platform, true);
      });
    });

    root.querySelector('[data-platform-tabs]')?.setAttribute('role', 'tablist');
    panels.forEach((panel) => panel.setAttribute('role', 'tabpanel'));

    if (root.dataset.platform === 'mac' || root.dataset.platform === 'windows') {
      selectPlatform(root.dataset.platform);
    } else {
      tabs.forEach((tab) => {
        tab.setAttribute('aria-selected', 'false');
        tab.setAttribute('tabindex', '0');
      });
      panels.forEach((panel) => {
        panel.hidden = false;
      });
    }

    root.querySelectorAll<HTMLAnchorElement>('[data-download-link]').forEach((link) => {
      link.addEventListener('click', () => {
        const action = link.closest<HTMLElement>('[data-download-action]');
        if (!action) return;
        action.dataset.started = 'true';
      });
    });

    const copyText = async (value: string) => {
      if (!navigator.clipboard?.writeText) {
        throw new Error('Clipboard access is unavailable');
      }
      await navigator.clipboard.writeText(value);
    };

    const linkButton = root.querySelector<HTMLButtonElement>('[data-copy-beta-link]');
    const linkAnnouncer = root.querySelector<HTMLElement>('[data-link-announcer]');
    linkButton?.addEventListener('click', async () => {
      try {
        await copyText('https://getmine.ai/beta');
        linkButton.textContent = 'Copied';
        if (linkAnnouncer) linkAnnouncer.textContent = 'Download link copied';
      } catch {
        linkButton.textContent = 'Copy unavailable';
        if (linkAnnouncer) linkAnnouncer.textContent = 'Copy unavailable. Use the email link instead.';
      }
    });

  });
</script>

<style>
  .download-page {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding-top: 4.75rem;
    background: var(--navy);
  }

  .download-glow {
    position: absolute;
    top: -12rem;
    left: 50%;
    width: 55rem;
    height: 55rem;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(29 191 176 / 15%), transparent 72%);
    filter: blur(5rem);
    pointer-events: none;
  }

  .download-memory-line {
    position: absolute;
    top: 19rem;
    left: 50%;
    width: max(100%, 90rem);
    height: 18rem;
    transform: translateX(-50%);
    opacity: 0.16;
    pointer-events: none;
  }

  .download-memory-line path {
    fill: none;
    stroke: var(--teal);
    stroke-width: 2;
  }

  .download-memory-line circle {
    fill: var(--teal);
  }

  .download-wrap {
    position: relative;
    display: grid;
    gap: 3.5rem;
    padding-block: clamp(2rem, 5vw, 4.5rem) clamp(4rem, 8vw, 7rem);
  }

  .download-card {
    width: min(100%, 48rem);
    margin-inline: auto;
    padding: clamp(1.35rem, 4vw, 3.25rem);
    border: 1px solid var(--line);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background: color-mix(in srgb, var(--navy-2) 94%, transparent);
    box-shadow: 0 40px 100px -55px rgb(0 0 0 / 95%);
    text-align: center;
  }

  .mina-mark {
    display: flex;
    width: clamp(4.5rem, 9vw, 6rem);
    height: clamp(4.5rem, 9vw, 6rem);
    align-items: center;
    justify-content: center;
    margin: 1.5rem auto 0;
    border: 1px solid var(--teal-line);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-style: italic;
  }

  .mina-mark i {
    color: var(--teal);
  }

  h1 {
    margin: 1rem 0 0;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.12;
    text-wrap: balance;
  }

  .download-lead {
    max-width: 39rem;
    margin: 1.25rem auto 0;
    color: var(--cream);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .platform-tabs {
    display: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 25rem);
    margin: 1.5rem auto 0;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--navy);
  }

  [data-enhanced='true'] .platform-tabs {
    display: grid;
  }

  .platform-tabs button {
    min-height: 2.75rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--cream);
    font-weight: 700;
    cursor: pointer;
  }

  .platform-tabs button[aria-selected='true'] {
    background: var(--teal);
    color: var(--navy);
  }

  .unsupported-notice {
    display: none;
    margin-top: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-md);
    background: var(--teal-surface);
    text-align: left;
  }

  [data-enhanced='true'][data-detected-platform='unsupported'] .unsupported-notice {
    display: block;
  }

  .unsupported-notice[hidden] {
    display: none;
  }

  .unsupported-notice p {
    margin: 0;
    color: var(--cream);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .unsupported-notice p + p {
    margin-top: 0.75rem;
  }

  .notice-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .notice-actions button,
  .notice-actions a {
    min-height: 2.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--cream);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .platform-panels {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .platform-panel {
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-align: left;
  }

  .platform-panel[hidden] {
    display: none;
  }

  [data-enhanced='true'][data-platform='mac'] [data-platform-panel='windows'],
  [data-enhanced='true'][data-platform='windows'] [data-platform-panel='mac'] {
    display: none;
  }

  .platform-panel h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .expectations-summary {
    max-width: 40rem;
    margin: 2rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-quiet);
    text-align: left;
  }

  .expectations-summary .eyebrow {
    font-size: clamp(1rem, 1.3vw, 1.125rem);
  }

  .expectation-list {
    display: grid;
    gap: 0;
    margin-top: 0.75rem;
  }

  .expectation-list p {
    margin: 0;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line-quiet);
    color: var(--cream);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  .expectations-summary > a,
  .trust-line,
  .minimum-os {
    margin: 0;
    color: var(--cream);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .expectations-summary > a {
    display: inline-flex;
    margin-top: 0.75rem;
  }

  .expectations-summary > a,
  .trust-line a {
    width: fit-content;
    color: var(--teal);
  }

  .download-action {
    display: grid;
    min-height: 9.25rem;
    align-items: center;
    margin-top: 0.75rem;
    padding-block: 0.25rem;
  }

  .download-start,
  .download-confirmation {
    grid-area: 1 / 1;
    transition: opacity 200ms var(--ease-gm);
  }

  .download-confirmation {
    visibility: hidden;
    opacity: 0;
  }

  .download-action[data-started='true'] .download-start {
    visibility: hidden;
    opacity: 0;
  }

  .download-action[data-started='true'] .download-confirmation {
    visibility: visible;
    opacity: 1;
  }

  .download-button {
    display: flex;
    width: 100%;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--ember);
    color: var(--navy);
    font-weight: 700;
    text-decoration: none;
  }

  .download-button--pending {
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--taupe);
  }

  .build-meta {
    margin: 0.75rem 0 0;
    color: var(--text-quiet);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-align: center;
  }

  .build-meta a {
    color: inherit;
  }

  .download-confirmation p {
    margin: 0;
    color: var(--cream);
    line-height: 1.55;
  }

  .download-confirmation p + p {
    margin-top: 0.4rem;
  }

  .download-confirmation a {
    display: inline-block;
    margin-top: 0.65rem;
    color: var(--teal);
  }

  .trust-line {
    padding-top: 1rem;
    border-top: 1px solid var(--line-quiet);
  }

  .minimum-os {
    margin-top: 0.35rem;
    color: var(--text-quiet);
    font-size: 0.8125rem;
  }

  .invite {
    position: relative;
    display: flex;
    justify-content: center;
    grid-column: 1 / -1;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-quiet);
  }

  .invite-trigger,
  .invite-panel > button {
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--cream);
    font-weight: 700;
    cursor: pointer;
  }

  .invite-panel {
    position: absolute;
    z-index: 3;
    top: calc(100% + 0.75rem);
    width: min(24rem, calc(100vw - 3rem));
    padding: 1.25rem;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-lg);
    background: var(--navy-2);
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / 90%);
    text-align: left;
  }

  .invite-panel[hidden] {
    display: none;
  }

