---
const exchanges = [
  {
    prompt: 'What did the consultant say about my knee?',
    action: 'Answers, and shows you the letter she read it in.',
    delay: '0ms',
  },
  {
    prompt: 'I’ve got a GP appointment, what should I flag?',
    action: 'Pulls together what’s changed since the last one.',
    delay: '600ms',
  },
  {
    prompt: 'My back pain is back.',
    action: 'She offers to log it. She only nudges when asked.',
    delay: '1200ms',
  },
  {
    prompt: 'File this with my supplements.',
    action: 'Updates your vault on the spot, from any source.',
    delay: '1800ms',
  },
];
---
<section id="meet-mina" class="meet-mina section-edge" aria-labelledby="meet-mina-heading" data-meet-mina>
  <div class="wrap section-pad">
    <header class="section-heading reveal" style="--delay: 0ms">
      <p class="eyebrow">Meet Mina</p>
      <h2 id="meet-mina-heading">
        Mina keeps your record straight.
        <span>Your doctors</span>
        <em>make the diagnoses.</em>
      </h2>
    </header>

    <div class="mina-intro reveal" style="--delay: 220ms">
      <div class="mark-wrap" aria-hidden="true">
        <span class="mina-ring"></span>
        <span class="mina-mark"><i>M</i><b>.</b></span>
      </div>
      <p class="mina-subtitle">Mina, your personal health agent</p>
    </div>

    <p class="exchange-label reveal" style="--delay: 640ms">Say this. She does this.</p>
    <div class="exchanges">
      {exchanges.map(({ prompt, action, delay }) => (
        <article class="exchange reveal" style={`--delay: ${delay}`}>
          <div class="speech-row">
            <p
              class="speech typed-speech"
              data-mina-typed={prompt}
              data-mina-delay={delay}
            >
              “{prompt}”
            </p>
          </div>
          <div class="mina-action">
            <span class="response-mark" role="img" aria-label="Mina"><i>M</i><b>.</b></span>
            <p>{action}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    position: relative;
    overflow: hidden;
    background: var(--navy);
  }

  .section-pad {
    padding-block: clamp(5rem, 8vw, 7.5rem);
  }


  .wrap {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 3rem), 82.5rem);
    max-width: 82.5rem;
  }

  .section-heading {
    max-width: 80rem;
  }

  .exchange-label {
    color: var(--teal);
    font-family: var(--font-ui);
    font-size: clamp(1.125rem, 1.4vw, 1.25rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .section-heading h2 {
    max-width: 80rem;
  }

  .section-heading h2 span {
    color: var(--teal);
    font-style: normal;
  }

  .mina-intro {
    display: flex;
    align-items: center;
    gap: clamp(1.35rem, 2.2vw, 2rem);
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
  }

  .mark-wrap {
    position: relative;
    display: grid;
    width: clamp(5.375rem, 7vw, 6.5rem);
    height: clamp(5.375rem, 7vw, 6.5rem);
    flex: 0 0 clamp(5.375rem, 7vw, 6.5rem);
    place-items: center;
  }

  .mina-ring,
  .mina-mark {
    position: absolute;
    border-radius: 50%;
  }

  .mina-ring {
    inset: -0.6rem;
    border: 1px solid var(--teal-line);
    box-shadow: 0 0 3.5rem rgb(29 191 176 / 12%);
    opacity: 0.32;
  }

  .mina-mark {
    display: inline-flex;
    inset: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--teal-line);
    background: var(--navy-2);
    box-shadow: 0 0 3.5rem rgb(29 191 176 / 20%);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 3.4vw, 3.2rem);
  }

  .mina-mark i {
    color: var(--cream);
    font-style: italic;
    font-weight: 300;
  }

  .mina-mark b {
    color: var(--teal);
    font-weight: 300;
  }

  .mina-subtitle {
    margin: 0;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.2;
  }

  .exchange-label {
    margin: clamp(2.25rem, 3.4vw, 2.75rem) 0 clamp(1.4rem, 2.2vw, 1.75rem);
  }

  .exchanges {
    display: grid;
    align-items: stretch;
    gap: clamp(1.125rem, 1.8vw, 1.5rem);
  }

  .exchange {
    min-width: 0;
    padding: clamp(1.375rem, 1.9vw, 1.625rem) clamp(1.25rem, 1.8vw, 1.5rem);
    border: 1px solid rgb(90 146 148 / 30%);
    border-radius: clamp(1.125rem, 1.6vw, 1.5rem);
    background: rgb(14 24 33 / 58%);
  }

  .speech-row {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .speech {
    width: fit-content;
    max-width: 100%;
    margin: 0;
    padding: 0.72rem 1.1rem;
    border-radius: 1.15rem 1.15rem 1.15rem 0.4rem;
    background: rgb(199 194 182 / 12%);
    color: var(--cream);
    font-size: clamp(1.15rem, 1.5vw, 1.375rem);
    line-height: 1.42;
  }

  .mina-action {
    display: grid;
    margin-top: clamp(1rem, 1.6vw, 1.25rem);
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: start;
    gap: 0.9rem;
    color: var(--cream);
  }

  .response-mark {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(55 207 195 / 48%);
    border-radius: 50%;
    background: var(--navy-2);
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1;
  }

  .response-mark i {
    color: var(--cream);
    font-style: italic;
    font-weight: 300;
  }

  .response-mark b {
    color: var(--teal);
    font-weight: 300;
  }

  .mina-action p {
    margin: 0.4rem 0 0;
    color: var(--cream);
    font-size: clamp(1.15rem, 1.5vw, 1.375rem);
    line-height: 1.5;
  }

  .meet-mina.is-animated .reveal {
    animation: mina-rise 620ms var(--ease-gm) var(--delay, 0ms) both;
  }

  .meet-mina.is-animated .mina-mark {
    animation: mina-breathe 5.2s ease-in-out infinite;
  }

  .meet-mina.is-animated .mina-ring {
    animation: mina-halo 5.2s ease-in-out infinite;
  }

  .typed-speech.is-typing::after {
    color: var(--teal);
    content: "│";
    animation: caret-blink 720ms steps(1) infinite;
  }

  @keyframes mina-rise {
    from {
      opacity: 0;
      transform: translateY(0.875rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes mina-breathe {
    50% {
      transform: scale(1.035);
      box-shadow: 0 0 3.5rem rgb(29 191 176 / 34%);
    }
  }

  @keyframes mina-halo {
    50% {
      transform: scale(1.14);
      opacity: 0.5;
    }
  }

  @keyframes caret-blink {
    50% { opacity: 0; }
  }

  @media (min-width: 64rem) {
    .exchanges {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meet-mina .reveal,
    .meet-mina .mina-mark,
    .meet-mina .mina-ring,
    .typed-speech::after {
      animation: none !important;
    }
  }

  @media (max-width: 47.99rem) {
    .section-pad {
      padding-block: clamp(4rem, 12vw, 5rem);
    }

    .wrap {
      width: min(calc(100% - 2.5rem), 82.5rem);
    }

    .exchange-label {
      font-size: 1rem;
    }

    .mina-intro {
      align-items: center;
    }

    .mark-wrap {
      width: 5rem;
      height: 5rem;
      flex-basis: 5rem;
    }

    .mina-mark {
      font-size: 2.25rem;
    }

    .mina-subtitle {
      font-size: clamp(1.375rem, 6vw, 1.7rem);
    }

    .exchange {
      padding: 1.35rem;
    }

    .speech-row {
      gap: 0.7rem;
    }

    .speech,
    .mina-action p {
      font-size: 1.125rem;
    }

    .mina-action {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: 0.75rem;
    }

    .response-mark {
      width: 2.75rem;
      height: 2.75rem;
      font-size: 1.55rem;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-meet-mina]');

  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const typedLines = Array.from(
      section.querySelectorAll<HTMLElement>('[data-mina-typed]'),
    );

    const startTyping = (typed: HTMLElement) => {
      const copy = typed.dataset.minaTyped ?? '';
      if (!copy) return;
      typed.textContent = '“';
      typed.classList.add('is-typing');
      let position = 0;
      const timer = window.setInterval(() => {
        typed.textContent = `“${copy.slice(0, position + 1)}`;
        position += 1;
        if (position >= copy.length) {
          window.clearInterval(timer);
          typed.textContent = `“${copy}”`;
          typed.classList.remove('is-typing');
        }
      }, 40);
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        section.classList.add('is-animated');
        typedLines.forEach((typed) => {
          const delay = Number.parseInt(typed.dataset.minaDelay ?? '0', 10);
          window.setTimeout(() => startTyping(typed), Number.isFinite(delay) ? delay : 0);
        });
        observer.disconnect();
      },
      { threshold: 0, rootMargin: '0px 0px -15% 0px' },
    );
    typedLines.forEach((typed) => {
      if (typed.dataset.minaTyped) typed.textContent = '“';
    });
    observer.observe(section);
  }
</script>
