---
interface Props {
  variant?: 'primary' | 'compact';
  placement?: 'beta' | 'menubar';
  conditional?: boolean;
  instanceId?: string;
}

const {
  variant = 'primary',
  placement = 'beta',
  conditional = false,
  instanceId = placement,
} = Astro.props;

const panelId = `invite-friend-${instanceId}`;
const inviteUrl = 'https://getmine.ai/invite';
---
<div
  class:list={[
    'invite-friend',
    `invite-friend--${variant}`,
    `invite-friend--${placement}`,
  ]}
  data-invite-friend
  data-invite-placement={placement}
  data-invite-conditional={conditional ? 'true' : undefined}
  hidden={conditional}
>
  <button
    class="invite-trigger"
    type="button"
    aria-expanded="false"
    aria-controls={panelId}
    data-invite-trigger
  >
    <span>Invite a friend</span>
    <span aria-hidden="true">→</span>
  </button>

  <div id={panelId} class="invite-overlay" data-invite-panel hidden>
    <div class="invite-backdrop" data-invite-dismiss aria-hidden="true"></div>
    <div
      class="invite-panel"
      role="dialog"
      aria-modal="true"
      aria-label="Invite a friend"
    >
      <button class="invite-close" type="button" aria-label="Close" data-invite-dismiss>
        <span aria-hidden="true">×</span>
      </button>
      <h2>Invite a friend</h2>
      <p>Invite someone who would benefit from owning their health data.</p>
      <div class="invite-preview">
        <img src="/invite-assets/link-preview.png" alt="Mina" width="80" height="80" />
        <div><strong>You’re invited to meet Mina</strong><p>A private invitation from a GetMine member. Text Mina on WhatsApp to get started.</p><small>getmine.ai</small></div>
      </div>
      <div class="invite-actions">
        <a class="share-action" href={`https://wa.me/?text=${encodeURIComponent(inviteUrl)}`} target="_blank" rel="noopener noreferrer" data-invite-share>Share on WhatsApp</a>
        <button class="copy-action" type="button" data-invite-copy data-invite-url={inviteUrl}>Copy link</button>
      </div>

      <p role="status" aria-live="polite" data-invite-announcer style="overflow-wrap:anywhere"></p>
    </div>
  </div>
</div>

<style>
  /* No z-index here: it would create a stacking context that traps the fixed
     overlay beneath the nav. The modal must resolve at root level. */
  .invite-friend {
    position: relative;
    display: inline-flex;
    max-width: 100%;
  }

  .invite-friend[hidden] {
    display: none;
  }

  .invite-trigger {
    display: inline-flex;
    min-height: 3.125rem;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    border: 1px solid color-mix(in srgb, var(--ember) 75%, transparent);
    border-radius: var(--radius-pill);
    background: transparent;
    color: #f2a07c;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      background 180ms var(--ease-gm),
      border-color 180ms var(--ease-gm),
      color 180ms var(--ease-gm),
      transform 180ms var(--ease-gm);
  }

  .invite-trigger:hover,
  .invite-trigger[aria-expanded='true'] {
    border-color: var(--ember);
    background: color-mix(in srgb, var(--ember) 18%, transparent);
    color: #ffd9c6;
    transform: translateY(-1px);
  }

  .invite-friend--compact .invite-trigger {
    min-height: 3.25rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
  }

  .invite-friend--beta .invite-trigger {
    min-height: 3.5rem;
    font-size: 1.125rem;
  }

  /* The invite dialog is a true modal (ruled 4 Aug): centred over the whole
     page, above the nav (z 50), with the page behind it locked. */
  .invite-overlay {
    position: fixed;
    z-index: 90;
    inset: 0;
    display: grid;
    padding: 1.25rem;
    place-items: center;
  }

  .invite-overlay[hidden] {
    display: none;
  }

  .invite-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(4 10 15 / 72%);
  }

  .invite-panel {
    position: relative;
    z-index: 1;
    width: min(35rem, 100%);
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    padding: 1.75rem;
    border: 1px solid color-mix(in srgb, var(--ember) 40%, transparent);
    border-radius: 1.125rem;
    background: var(--navy-2);
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / 85%);
    text-align: left;
    animation: invite-panel-in 220ms var(--ease-gm);
  }

  .invite-close {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--cream);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .invite-close:hover {
    border-color: var(--ember);
    color: #ffd9c6;
  }

  .invite-panel h2 {
    margin: 0;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  /* The modal is portalled to <body> on open, so its type is set here rather
     than through the placement variant — the variant ancestor is left behind. */
  .invite-panel > p {
    margin: 0.5rem 0 0;
    color: var(--cream);
    font-size: 1rem;
    line-height: 1.5;
  }

  .invite-preview { display: flex; gap: 1rem; margin-top: 1.5rem; padding: 1rem; background: var(--navy); border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--cream); }
  .invite-preview img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; }
  .invite-preview strong { font-size: 1.125rem; }
  .invite-preview p { font-size: .9375rem; line-height: 1.5; margin: .4rem 0; }
  .invite-preview small { opacity: .7; }
  .share-action { text-decoration: none; background: var(--teal); color: var(--navy); font-weight: 700; border-radius: var(--radius-pill); }

  .invite-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .invite-actions button,
  .invite-actions a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--cream);
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .invite-actions button:hover {
    border-color: var(--teal);
    color: var(--teal);
  }

  .invite-actions .copy-action:hover { border-color: var(--teal); color: var(--teal); }
  .invite-actions .share-action:hover { filter: brightness(1.06); }

  .invite-actions .share-action { background: var(--ember); color: var(--navy); border-color: var(--ember); }
  .invite-actions .copy-action { background: transparent; color: var(--cream); border-color: var(--line); }

  @keyframes invite-panel-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 47.99rem) {
    .invite-friend--compact {
      display: none;
    }

    .invite-friend--primary {
      width: 100%;
    }

    .invite-friend--primary .invite-trigger {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .invite-panel {
      animation: none;
    }
  }
</style>
