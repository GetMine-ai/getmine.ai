</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-move-examples]');
  if (rail) {
    const examples = Array.from(rail.querySelectorAll<HTMLElement>('.gp'));
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.site-move .dots button'));
    const narrow = matchMedia('(max-width: 63.99rem)');
    const markCurrent = () => {
      const centre = rail.getBoundingClientRect().left + rail.clientWidth / 2;
      const distances = examples.map(example => {
        const rect = example.getBoundingClientRect();
        return Math.abs(rect.left + rect.width / 2 - centre);
      });
      const current = distances.indexOf(Math.min(...distances));
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === current)));
      return current;
    };
    const show = (index: number) => {
      if (!narrow.matches || !examples[index]) return;
      const rect = examples[index].getBoundingClientRect();
      const railRect = rail.getBoundingClientRect();
      const left = rail.scrollLeft + rect.left - railRect.left - (rail.clientWidth - rect.width) / 2;
      rail.scrollTo({ left, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    buttons.forEach((button, i) => button.addEventListener('click', () => show(i)));
    rail.addEventListener('keydown', event => {
      if (!narrow.matches || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const current = markCurrent();
      const target = event.key === 'Home' ? 0 : event.key === 'End' ? examples.length - 1
        : Math.max(0, Math.min(examples.length - 1, current + (event.key === 'ArrowRight' ? 1 : -1)));
      show(target);
    });
    let frame = 0;
    rail.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(markCurrent);
    }, { passive: true });
    const updateLayout = () => {
      rail.tabIndex = narrow.matches ? 0 : -1;
      markCurrent();
    };
    new ResizeObserver(updateLayout).observe(rail);
    narrow.addEventListener('change', updateLayout);
    updateLayout();
  }
</script>
