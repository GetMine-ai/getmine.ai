<style is:global>
.site-vault { background:#060c14; color:#e8faf8; font-family:var(--font-sans); -webkit-font-smoothing:antialiased; }
.site-vault a { color:inherit; text-decoration:none; }
.site-vault .pg { height:100%; box-sizing:border-box; padding:0 64px; border-top:1px solid rgba(181,200,202,.12); }
.site-vault .sec { padding:96px 0; }
.site-vault .eyebrow { margin:0 0 18px; font:600 16px/1 var(--font-sans); letter-spacing:.12em; text-transform:uppercase; color:#1dbfb0; }
.site-vault .h2 { margin:0; max-width:15em; font:400 48px/1.12 var(--font-display); letter-spacing:-.022em; text-wrap:balance; }
.site-vault .acc { color:#1dbfb0; }
.site-vault .mk i { font-style:italic; font-weight:300; }
.site-vault .mk b { color:#1dbfb0; font-weight:300; }
.site-vault .mk { flex:none; display:flex; align-items:center; justify-content:center; width:30px; height:30px; box-sizing:border-box; border:1.5px solid #1dbfb0; border-radius:50%; background:#0b131d; color:#e8faf8; font:300 15px/1 var(--font-display); }
.site-vault .h2.tri { max-width:none; font-size:56px; line-height:1.1; }
.site-vault .sec { padding-top:96px; }
.site-vault .eyebrow { margin:0 0 18px; text-align:left; align-self:flex-start; font:600 16px/1 var(--font-sans); letter-spacing:.12em; text-transform:uppercase; color:#1dbfb0; }
.site-vault .sec > h2:first-of-type, .site-vault .h2.tri { margin:0; text-align:left; align-self:flex-start; font:400 60px/1.1 var(--font-display); letter-spacing:-.025em; }
.site-vault .vg { display:grid; grid-template-columns:270px minmax(0,1fr) 270px; column-gap:36px; align-items:center; margin-top:64px; }
.site-vault .side { display:flex; flex-direction:column; gap:14px; }
.site-vault .sh { display:flex; align-items:center; gap:14px; margin:0 0 6px; font:400 36px/1 var(--font-display); letter-spacing:-.02em; }
.site-vault .mk.big { width:44px; height:44px; font-size:22px; border-width:2px; }
.site-vault .vk { display:grid; place-items:center; width:44px; height:44px; box-sizing:border-box; border:2px solid #1dbfb0; border-radius:50%; background:#0b131d; }
.site-vault .vk svg { width:22px; height:22px; fill:none; stroke:#1dbfb0; stroke-width:1.6; stroke-linejoin:round; }
.site-vault .tl { display:flex; flex-direction:column; gap:12px; }
.site-vault .t { padding:16px 18px; border:1.5px solid rgba(29,191,176,.75); border-radius:14px; background:#13262f; box-shadow:inset 0 1px 0 rgba(232,250,248,.08), 0 10px 26px rgba(0,0,0,.45); }
.site-vault .tk { margin:0 0 6px; font:700 14px/1 var(--font-sans); letter-spacing:.12em; text-transform:uppercase; color:#3ad6c7; }
.site-vault .tv { margin:0; font:400 18px/1.4 var(--font-sans); color:#ffffff; }
.site-vault .app { position:relative; margin:0; }
.site-vault .app::before { content:""; position:absolute; inset:-8% -6%; border-radius:50%; background:radial-gradient(closest-side, rgba(29,191,176,.22), rgba(29,191,176,0)); filter:blur(12px); }
.site-vault .app img { position:relative; display:block; width:100%; height:auto; border-radius:14px; box-shadow:0 0 0 1px rgba(232,250,248,.14), 0 30px 80px rgba(0,0,0,.6); }
.site-vault .app .bz { position:relative; padding:8px; border-radius:18px; background:#05080b; box-shadow:0 0 0 1.5px #3a4450, 0 0 0 3px #0d1116, 0 50px 100px rgba(0,0,0,.75), 0 0 90px rgba(29,191,176,.22); }
.site-vault .app .bz img { border-radius:11px; box-shadow:none; }
.site-vault .vg { grid-template-columns:228px minmax(0,1fr) 228px; column-gap:32px; }
.site-vault .vf { position:relative; z-index:1; display:flex; justify-content:center; margin-top:28px; }
.site-vault .nd { margin:0; text-align:center; font:600 20px/1.4 var(--font-sans); color:#c7c2b6; }
.site-vault .nd b { font-weight:800; color:#ffffff; }
.site-vault .app { align-self:center; }
@media (min-width: 48rem) {
.site-vault .vg { align-items:stretch; }
.site-vault .side { justify-content:center; }
.site-vault .tl { gap:14px; }
.site-vault .t { min-height:104px; box-sizing:border-box; display:flex; flex-direction:column; justify-content:center; }
.site-vault .tv { font-size:16.5px; }
}
@media (max-width: 47.99rem) {
.site-vault .pg { padding:0 20px; }
.site-vault .sec { padding:64px 0; }
.site-vault .eyebrow { font-size:14px; }
.site-vault .h2 { font-size:32px; }
.site-vault .h2.tri { font-size:34px; }
.site-vault .sec { padding-top:64px; }
.site-vault .eyebrow { font-size:14px; }
.site-vault .sec > h2:first-of-type, .site-vault .h2.tri { font-size:36px; }
.site-vault .app .bz { padding:7px 7px 8px; border-radius:14px; }
.site-vault .app .bz img { border-radius:5px; }
.site-vault .vg { display:flex; flex-direction:column; gap:36px; margin-top:36px; }
.site-vault .app { order:-1; margin:0 -8px; }
.site-vault .sh { font-size:28px; }
.site-vault .mk.big, .site-vault .vk { width:38px; height:38px; }
.site-vault .tl { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.site-vault .t { padding:12px 14px; }
.site-vault .tk { font-size:12px; }
.site-vault .tv { font-size:15px; }
.site-vault .vf { flex-direction:column; align-items:stretch; margin-top:24px; gap:14px; }
.site-vault .nd { text-align:center; }
.site-vault .nd { font-size:15px; }
}

.site-vault { background:#060c14; color:#e8faf8; scroll-margin-top:5.25rem; }
.site-vault .pg { height:auto; max-width:90rem; margin:0 auto; }
@media (max-width: 80rem) { .site-vault .pg { padding-inline:40px; } .site-vault .vg { grid-template-columns:210px minmax(0,1fr) 210px; column-gap:24px; } }
@media (min-width: 48rem) and (max-width: 71.99rem) {
  .site-vault .vg { display:grid; grid-template-columns:1fr 1fr; gap:32px 24px; }
  .site-vault .vg .app { grid-column:1 / -1; order:-1; }
}
@media (min-width: 72rem) {
  /* Headings share their own row; the screenshot and both pill stacks share
     the next row, so their top and bottom edges always align. */
  .site-vault .vg { grid-template-rows:auto auto; row-gap:14px; }
  .site-vault .side { display:contents; }
  .site-vault .side:first-child .sh { grid-column:1; grid-row:1; }
  .site-vault .side:first-child .tl { grid-column:1; grid-row:2; }
  .site-vault .side:last-child .sh { grid-column:3; grid-row:1; }
  .site-vault .side:last-child .tl { grid-column:3; grid-row:2; }
  .site-vault .tl { display:grid; grid-template-rows:repeat(4,1fr); }
  .site-vault .app { grid-column:2; grid-row:2; align-self:stretch; min-height:0; }
  .site-vault .app .bz { position:absolute; inset:0; }
  .site-vault .app .bz img { height:100%; object-fit:contain; }
}

</style>

<style is:global>
@media (max-width: 47.99rem) { .site-vault .pg { padding-inline: 20px; } }
</style>

<style is:global>
/* Contain the screenshot's decorative glow without widening the page. */
.site-vault { overflow: clip; }
</style>
