---
// Ported from the approved canvas board. Markup and sizes follow the mock-up;
// the phone layout applies below 48rem.
import { whatsappLink } from '../../data/whatsapp';
const html = '<div class="pg"><section class="sec"><p class="eyebrow">About us</p><h2 class="one"><span class="w">Our conviction.</span> <span class="t">A missing infrastructure layer.</span></h2><div class="l1"><div class="story"><div class="vis2"><span class="mk2" role="img" aria-label="Mina"><i>M</i><b>.</b></span><p>Everyone should own their lifelong health memory.</p></div><p class="intro2">Your health record is scattered across systems never built for you, and much of it lives only in your head.</p><p class="intro2">GetMine is one unified record in a secure, encrypted vault on your computer, with Mina working across it. That’s our mission.</p></div><div class="team"><article class="fr"><img src="/assets/site/sabine-color.jpg" width="1000" height="1000" alt="Sabine Azancot, Co-founder & CEO of GetMine" /><div><h3>Sabine Azancot</h3><p class="role">Co-founder & CEO</p><p class="disc">AI, product development and human behaviour.</p></div></article><article class="fr"><img src="/assets/site/mike-color.jpg" width="1000" height="1000" alt="Mike Anderson, Co-founder & Chief Architect of GetMine" /><div><h3>Mike Anderson</h3><p class="role">Co-founder & Chief Architect</p><p class="disc">Sovereign architecture and agentic systems.</p></div></article></div></div></section></div>'.replaceAll('__WA__', whatsappLink('Hi Mina'));
