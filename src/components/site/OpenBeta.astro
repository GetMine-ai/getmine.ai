<div class="site-beta" id="open-beta"><Fragment set:html={html} /></div>

<style is:global>
.site-beta { background:#060c14; color:#e8faf8; font-family:var(--font-sans); -webkit-font-smoothing:antialiased; }
.site-beta a { color:inherit; text-decoration:none; }
.site-beta .pg { height:100%; box-sizing:border-box; padding:0 64px; border-top:1px solid rgba(181,200,202,.12); }
.site-beta .sec { padding:96px 0; }
.site-beta .eyebrow { margin:0 0 18px; font:600 16px/1 var(--font-sans); letter-spacing:.12em; text-transform:uppercase; color:#1dbfb0; }
.site-beta .one { margin:0; font:400 60px/1.1 var(--font-display); letter-spacing:-.025em; }
.site-beta .one .t { color:#1dbfb0; }
.site-beta .one .s { color:#c7c2b6; }
.site-beta .intro { margin:24px 0 0; max-width:52em; font:400 21px/1.6 var(--font-sans); color:#d3e3e3; }
.site-beta .fds { display:grid; grid-template-columns:1fr 260px 1fr; align-items:center; gap:24px; margin-top:64px; }
.site-beta .fd { text-align:center; }
.site-beta .fd img { display:block; width:240px; height:240px; margin:0 auto 22px; object-fit:cover; border-radius:20px; border:1px solid rgba(29,191,176,.35); box-shadow:0 0 40px rgba(29,191,176,.12); }
.site-beta .fd h3 { margin:0; font:400 34px/1.15 var(--font-display); letter-spacing:-.015em; }
