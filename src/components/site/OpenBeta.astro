.site-beta .next2 li { position:relative; display:flex; flex-direction:column; align-items:center; gap:18px; padding:34px 20px 30px; border:1px dashed rgba(29,191,176,.45); border-radius:20px; background:radial-gradient(120% 90% at 50% 0%, rgba(29,191,176,.10), rgba(29,191,176,0) 70%); }
