.site-beta .disc { margin:18px 0 0; font:400 25px/1.3 var(--font-display); color:#e8faf8; }
.site-beta .line { margin:8px auto 0; max-width:22em; font:400 18px/1.5 var(--font-sans); color:#b5c8ca; }
.site-beta .join { display:flex; flex-direction:column; align-items:center; text-align:center; }
.site-beta .mk { display:flex; align-items:center; justify-content:center; width:96px; height:96px; box-sizing:border-box; border:2px solid #1dbfb0; border-radius:50%; background:#0b131d; font:300 48px/1 var(--font-display); box-shadow:0 0 24px rgba(29,191,176,.35),0 0 60px rgba(29,191,176,.16); }
.site-beta .mk i { font-style:italic; }
