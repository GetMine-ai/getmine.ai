.site-beta .bt { margin:0; font:400 26px/1.3 var(--font-display); color:#e8faf8; }
.site-beta .next { display:flex; align-items:center; gap:36px; margin-top:44px; padding-top:36px; border-top:1px solid rgba(181,200,202,.14); }
