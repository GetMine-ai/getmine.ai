<!-- WHAT BECOMES POSSIBLE (refreshed Wave-2 styling + flippable photo cards) -->
<section id="why-getmine">
  <div class="possible-inner reveal-stagger">
    <p class="possible-eyebrow">What becomes possible</p>
    <h2 class="possible-headline">Your health memory <span class="beat-teal">put to work</span> <span class="beat-taupe">for what matters and what&rsquo;s ahead.</span></h2>

    <div class="possible-grid">
      <div class="constellation-hub" aria-hidden="true">
        <svg viewBox="0 0 80 80">
          <circle class="hub-dot" cx="40" cy="40" r="2.6"/>
          <circle class="hub-ring" cx="40" cy="40" r="9" opacity=".45"/>
          <line x1="40" y1="40" x2="12" y2="12" opacity=".55"/>
          <line x1="40" y1="40" x2="68" y2="12" opacity=".55"/>
          <line x1="40" y1="40" x2="12" y2="68" opacity=".55"/>
          <line x1="40" y1="40" x2="68" y2="68" opacity=".55"/>
        </svg>
      </div>
      <article class="possible-card" id="pc0">
          <div class="possible-card-img-wrap">
            <img class="possible-card-img" src="/assets/possible-never-cold.jpg" loading="lazy" decoding="async">
            <div class="possible-card-img-fade"></div>
          </div>
          <div class="possible-card-text">
            <h3>Never go in cold.</h3>
            <p>Before your appointment, Mina gives you and your clinician the context that matters: latest results, what&rsquo;s changed, the questions to ask.</p>
          </div>
      </article>
      <article class="possible-card" id="pc1">
          <div class="possible-card-img-wrap">
            <img class="possible-card-img" src="/assets/possible-family-vault.jpg" loading="lazy" decoding="async">
            <div class="possible-card-img-fade"></div>
          </div>
          <div class="possible-card-text">
            <h3>One family vault. Everyone you love.</h3>
            <p>Mina keeps appointments, medication, school forms and referrals for the people you care for, all in one place.</p>
          </div>
      </article>
      <article class="possible-card" id="pc2">
          <div class="possible-card-img-wrap">
            <img class="possible-card-img" src="/assets/possible-passport.jpg" loading="lazy" decoding="async">
            <div class="possible-card-img-fade"></div>
          </div>
          <div class="possible-card-text">
            <h3>A health passport on the move.</h3>
            <p>Vaccines, key results, allergies. Mina has them ready for travel, moving, an urgent moment abroad, or meeting a new doctor.</p>
          </div>
      </article>
      <article class="possible-card" id="pc3">
          <div class="possible-card-img-wrap">
            <img class="possible-card-img" src="/assets/possible-ai.jpg" loading="lazy" decoding="async">
            <div class="possible-card-img-fade"></div>
          </div>
          <div class="possible-card-text">
            <h3>Get the best from AI.</h3>
            <p>Mina shares enough context for answers built for you, not the average person. Never your whole record.</p>
          </div>
      </article>
    </div>
  </div>
</section>
