---
const founders = [
  {
    name: 'Sabine Azancot',
    role: 'Co-founder & CEO',
    discipline: 'AI, product and human behaviour.',
    line: 'Turns intelligence into meaningful consumer value.',
    image: 'sabine-color',
    extension: 'jpg',
  },
  {
    name: 'Mike Anderson',
    role: 'Co-founder & Architect',
    discipline: 'Self-sovereign systems and architecture.',
    line: 'Builds technology that keeps people in control.',
    image: 'mike-color',
    extension: 'jpg',
  },
];
---
<section id="about-us" class="section-edge" aria-labelledby="about-us-heading">
  <div class="about-glow" aria-hidden="true"></div>
  <div class="wrap section-pad">
    <header class="section-heading">
      <p class="eyebrow">About us</p>
      <h2 id="about-us-heading">
        One thesis.
        <span>One missing infrastructure layer to build.</span>
      </h2>
    </header>
    <p class="intro">
      Contextual and longitudinal. Our platform is consumer-sovereign by design,
      agnostic to services, hardware or borders — a decentralised, sovereign data
      architecture powered by an intelligent agentic layer.
    </p>

    <div class="founders">
      {founders.map((founder, index) => (
        <>
          {index === 1 && (
            <div class="join">
              <span class="join-line" aria-hidden="true"></span>
              <span class="mina-mark" role="img" aria-label="GetMine"><i>M</i><b>.</b></span>
              <p>Where the two meet</p>
              <em>this becomes GetMine.</em>
            </div>
          )}
          <article>
            <div class="portrait">
              <picture>
                <source srcset={`/assets/redesign/${founder.image}.avif`} type="image/avif" />
                <source srcset={`/assets/redesign/${founder.image}.webp`} type="image/webp" />
                <img
                  src={`/assets/redesign/${founder.image}.${founder.extension}`}
                  alt={`${founder.name}, ${founder.role} of GetMine`}
                  width="1000"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div>
              <h3>{founder.name}</h3>
              <p class="role">{founder.role}</p>
              <span class="rule"></span>
              <p class="discipline">{founder.discipline}</p>
              <p class="line">{founder.line}</p>
            </div>
          </article>
        </>
      ))}
    </div>

    <p class="closing">
      AI without memory is generic.<br />
      Memory without agency is <em>not truly yours.</em>
    </p>
  </div>
</section>

<style>
  section {
    position: relative;
    overflow: hidden;
    background: var(--navy);
  }

  .about-glow {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: 58rem;
    height: 34rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--teal), transparent 72%);
    filter: blur(9rem);
    opacity: 0.1;
    pointer-events: none;
  }

  .wrap {
    position: relative;
    z-index: 1;
  }

  .section-heading h2 span {
    color: var(--teal);
    font-style: italic;
  }

  .intro {
    max-width: 45rem;
    margin: 1.5rem 0 0;
    color: var(--text-secondary);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .founders {
    display: grid;
    gap: 3rem;
    margin-top: 3.5rem;
  }

  article {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .portrait {
    position: relative;
    width: 10rem;
    height: 10rem;
    flex: 0 0 auto;
    padding: 1px;
    border: 1px solid var(--teal-line);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 0 3.5rem rgb(29 191 176 / 20%);
    overflow: hidden;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 42%;
    filter: contrast(1.02) saturate(0.92);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 3vw, 1.875rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .role {
    margin: 0.5rem 0 0;
    color: var(--teal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rule {
    display: block;
    width: 3.5rem;
    height: 1px;
    margin: 1rem auto 0;
    background: rgb(29 191 176 / 50%);
  }

  .discipline {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.375rem);
    font-style: italic;
    line-height: 1.3;
  }

  .line {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.5vw, 1.0625rem);
    line-height: 1.55;
  }

  .join {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .join-line {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    display: none;
    width: 230%;
    height: 1px;
    transform: translate(-50%, -50%);
    background: linear-gradient(to right, transparent, rgb(29 191 176 / 35%), transparent);
  }

  .mina-mark {
    display: inline-flex;
    width: 4.25rem;
    height: 4.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--teal-line);
    border-radius: 50%;
    background: var(--navy-2);
    box-shadow: 0 0 3rem rgb(29 191 176 / 20%);
    font-family: var(--font-display);
    font-size: 1.875rem;
  }

  .mina-mark i {
    font-style: italic;
  }

  .mina-mark b {
    color: var(--teal);
    font-weight: 300;
  }

  .join p {
    margin: 1rem 0 0;
    color: var(--teal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .join em {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
  }

  .closing {
    max-width: 47.5rem;
    margin: 3.5rem auto 0;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 3.4vw, 2.5rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-align: center;
  }

  .closing em {
    color: var(--teal);
    font-style: italic;
  }

  @media (min-width: 40rem) {
    article {
      flex-direction: row;
      text-align: left;
    }

    .rule {
      margin-left: 0;
    }

    .portrait {
      width: 12rem;
      height: 12rem;
    }
  }

  @media (min-width: 64rem) {
    .founders {
      grid-template-columns: minmax(0, 1fr) 12rem minmax(0, 1fr);
      align-items: center;
      gap: 1.5rem;
    }

    .founders article:first-child {
      order: 1;
    }

    .join {
      order: 2;
    }

    .founders article:last-child {
      order: 3;
    }

    .join-line {
      display: block;
    }
  }
</style>
