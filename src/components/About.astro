---
const founders = [
  {
    name: 'Sabine Azancot',
    role: 'Co-founder & CEO',
    disciplineLineOne: 'AI, product development and',
    disciplineLineTwo: 'human behavior.',
    lineOne: 'Turns intelligence into',
    lineTwo: 'meaningful consumer value.',
    image: 'sabine-color',
    extension: 'jpg',
  },
  {
    name: 'Mike Anderson',
    role: 'Co-founder & Architect',
    disciplineLineOne: 'Sovereign architecture and',
    disciplineLineTwo: 'agentic systems.',
    lineOne: 'Builds the technology.',
    lineTwo: 'Keeps people in control.',
    image: 'mike-color',
    extension: 'jpg',
  },
];
---
<section id="about-us" class="section-edge" aria-labelledby="about-us-heading">
  <div class="about-glow" aria-hidden="true"></div>
  <div class="wrap section-pad">
    <header class="section-heading">
      <p class="eyebrow">About us</p>
      <h2 id="about-us-heading">
        <span class="beat beat-one">One thesis.</span>
        <span class="beat beat-two">One missing infrastructure layer.</span>
        <span class="beat beat-three">One company.</span>
      </h2>
    </header>
    <p class="intro">
      Your health record is scattered across systems that were never built for you,
      and the rest of it lives only in your head. The missing piece is a single
      record you own outright and an agent, Mina, who makes it work for you.
      That’s the whole company.
    </p>

    <div class="founders">
      {founders.map((founder, index) => (
        <>
          {index === 1 && (
            <div class="join">
              <span class="join-line" aria-hidden="true"></span>
              <span class="mark-wrap" aria-hidden="false"><span class="mina-ring"></span><span class="mina-mark" role="img" aria-label="GetMine"><i>M</i><b>.</b></span></span>
              <p>Where the two meet</p>
              <em>GetMine becomes possible.</em>
            </div>
          )}
          <article class:list={[index === 0 ? 'founder-left' : 'founder-right']}>
            <div class:list={['portrait', index === 1 && 'portrait-mike']}>
              <div class="portrait-frame">
                <picture>
                  <source srcset={`/assets/redesign/${founder.image}.avif`} type="image/avif" />
                  <source srcset={`/assets/redesign/${founder.image}.webp`} type="image/webp" />
                  <img
                    src={`/assets/redesign/${founder.image}.${founder.extension}`}
                    alt={`${founder.name}, ${founder.role} of GetMine`}
                    width="1000"
                    height="1000"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </div>
            </div>
            <div>
              <h3>{founder.name}</h3>
              <p class="role">{founder.role}</p>
              <span class="rule"></span>
              <p class="discipline">
                {founder.disciplineLineOne}<br />
                {founder.disciplineLineTwo}
              </p>
              <p class="line">
                {founder.lineOne}<br />
                {founder.lineTwo}
              </p>
            </div>
          </article>
        </>
      ))}
    </div>

    <p class="closing">
      AI without memory is generic.<br />
      Memory without agency is <em>not truly yours.</em>
    </p>
  </div>
</section>

<style>
  section {
    position: relative;
    overflow: hidden;
    background: var(--navy);
  }

  .about-glow {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: 58rem;
    height: 34rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--teal), transparent 72%);
    filter: blur(9rem);
    opacity: 0.1;
    pointer-events: none;
  }

  .wrap {
    position: relative;
    z-index: 1;
  }

  .section-heading h2 .beat {
    font-family: inherit;
    font-style: inherit;
  }

  .section-heading h2 .beat-one {
    color: var(--cream);
  }

  .section-heading h2 .beat-two {
    color: var(--teal);
  }

  .section-heading h2 .beat-three {
    color: var(--taupe);
  }

  .intro {
    max-width: 62rem;
    margin: 1.5rem 0 0;
    color: var(--cream);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .founders {
    display: grid;
    gap: 3.5rem;
    margin-top: 2.25rem;
  }

  article {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  article > div:last-child {
    width: min(100%, 13.75rem);
  }

  .portrait {
    position: relative;
    width: 13.75rem;
    height: 13.75rem;
    flex: 0 0 auto;
    border: 0;
    border-radius: 0;
    overflow: visible;
    align-self: center;
    box-shadow: 0 0 3.5rem rgb(29 191 176 / 12%);
  }

  .portrait-frame {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(231 239 237 / 20%);
  }

  .portrait::before,
  .portrait::after {
    position: absolute;
    width: 4.75rem;
    height: 4.75rem;
    content: "";
    pointer-events: none;
  }

  .portrait::before {
    top: -0.875rem;
    right: -0.875rem;
    border-top: 1px solid rgb(29 191 176 / 55%);
    border-right: 1px solid rgb(29 191 176 / 55%);
  }

  .portrait::after {
    bottom: -0.875rem;
    left: -0.875rem;
    border-bottom: 1px solid rgb(29 191 176 / 55%);
    border-left: 1px solid rgb(29 191 176 / 55%);
  }

  .portrait picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
    object-position: 50% 42%;
    filter: contrast(1.02) saturate(0.92);
  }

  .portrait-mike img {
    object-position: 50% 42%;
    transform: scale(1.3);
    filter: brightness(0.74) contrast(1.08) saturate(0.65);
  }

  .portrait-mike .portrait-frame::after {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 46%, transparent 38%, rgb(5 18 23 / 32%) 100%),
      rgb(29 191 176 / 4%);
    content: "";
    pointer-events: none;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .role {
    margin: 0.5rem 0 0;
    color: var(--teal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rule {
    display: block;
    width: 3.5rem;
    height: 1px;
    margin: 1rem auto 0;
    background: rgb(29 191 176 / 50%);
  }

  .discipline {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-style: italic;
    line-height: 1.25;
  }

  .line {
    margin: 0.75rem 0 0;
    color: var(--cream);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.55;
  }

  .join {
    position: relative;
    display: flex;
    min-height: 13.75rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .join-line {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    display: none;
    width: calc(100% + 10rem);
    height: 1px;
    transform: translate(-50%, -50%);
    background: linear-gradient(
      to right,
      transparent,
      rgb(29 191 176 / 24%) 18%,
      rgb(29 191 176 / 24%) 82%,
      transparent
    );
  }

  .mark-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    width: 5.125rem;
    height: 5.125rem;
    place-items: center;
  }

  .join::after {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: 1px;
    height: 11.5rem;
    transform: translate(-50%, -50%);
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(29 191 176 / 24%) 18%,
      rgb(29 191 176 / 24%) 82%,
      transparent
    );
    content: "";
  }

  .mina-ring,
  .mina-mark {
    position: absolute;
    border-radius: 50%;
  }

  .mina-ring {
    inset: -0.875rem;
    border: 1px solid var(--teal-line);
    box-shadow: 0 0 3.5rem rgb(29 191 176 / 12%);
    opacity: 0.32;
  }

  .mina-mark {
    display: inline-flex;
    inset: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--teal-line);
    background: var(--navy-2);
    box-shadow: 0 0 3.5rem rgb(29 191 176 / 18%);
    font-family: var(--font-display);
    font-size: 2.25rem;
  }

  .mina-mark i {
    color: var(--cream);
    font-style: italic;
    font-weight: 300;
  }

  .mina-mark b {
    color: var(--teal);
    font-weight: 300;
  }

  .join p {
    position: absolute;
    z-index: 1;
    top: calc(50% + 5.1rem);
    margin: 1rem 0 0;
    color: var(--teal);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .join em {
    position: absolute;
    z-index: 1;
    top: calc(50% + 7.35rem);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    white-space: nowrap;
  }

  .closing {
    max-width: 47.5rem;
    margin: 4.5rem auto 0;
    padding-top: 2.75rem;
    border-top: 1px solid rgb(231 239 237 / 18%);
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 3.4vw, 2.5rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-align: center;
  }

  .closing em {
    color: var(--teal);
    font-style: italic;
  }

  @media (min-width: 40rem) {
    article {
      flex-direction: column;
    }

    .portrait {
      width: 13.75rem;
      height: 13.75rem;
    }
  }

  @media (min-width: 64rem) {
    .founders {
      grid-template-columns: minmax(17rem, 1fr) 17rem minmax(17rem, 1fr);
      align-items: start;
      gap: clamp(1.75rem, 2.8vw, 2.75rem);
    }

    .founders article:first-child {
      order: 1;
    }

    .join {
      order: 2;
      align-self: start;
    }

    .founders article:last-child {
      order: 3;
    }

    article > div:last-child {
      width: min(100%, 23rem);
      text-align: right;
    }

    .join-line {
      display: block;
    }

    .founder-left > div:last-child,
    .founder-right > div:last-child {
      width: min(100%, 23rem);
    }

    .founder-left .portrait {
      align-self: flex-end;
    }

    .founder-left > div:last-child {
      align-self: flex-end;
    }

    .founder-left .rule {
      margin-left: auto;
    }

    .founder-right .portrait,
    .founder-right > div:last-child {
      align-self: flex-start;
    }

    .founder-right > div:last-child {
      text-align: left;
    }

    .founder-right .rule {
      margin-right: auto;
      margin-left: 0;
    }
  }

  @media (min-width: 64rem) and (max-height: 52rem) {
    .wrap.section-pad {
      padding-block: 2.5rem;
    }

    .intro {
      margin-top: 0.875rem;
      font-size: 1rem;
      line-height: 1.45;
    }

    .founders {
      gap: 2rem;
      margin-top: 1.5rem;
    }

    article {
      gap: 1rem;
    }

    .portrait {
      width: 9.75rem;
      height: 9.75rem;
    }

    h3 {
      font-size: 1.5rem;
    }

    .role {
      margin-top: 0.375rem;
    }

    .rule,
    .discipline {
      margin-top: 0.625rem;
    }

    .line {
      margin-top: 0.5rem;
      font-size: 0.9375rem;
      line-height: 1.4;
    }

    .mark-wrap {
      width: 3.5rem;
      height: 3.5rem;
    }

    .mina-mark {
      font-size: 1.625rem;
    }

    .join p {
      top: calc(50% + 3.9rem);
      margin-top: 0.75rem;
    }

    .join em {
      top: calc(50% + 5.75rem);
    }

    .closing {
      margin-top: 1.75rem;
      font-size: clamp(1.5rem, 2.7vw, 2rem);
    }
  }

  #about-us .section-heading,
  .about .section-heading {
    max-width: none;
  }
</style>
