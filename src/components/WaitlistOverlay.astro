<!-- DESKTOP ACCESS REQUEST OVERLAY -->
<section
  id="waitlist"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="hw-title"
>
  <button class="wl-close" onclick="closeWaitlist()" aria-label="Close beta access request">×</button>
  <canvas id="wl-cv" width="1920" height="992" aria-hidden="true"></canvas>
  <div class="wl-ui">
    <div class="hw-label on" id="hw-label">GetMine open beta</div>

    <div class="hw-capture active" id="hw-capture">
      <div class="hw-cap-label" id="hw-title">Request beta access</div>
      <div class="hw-cap-sub hw-cap-intro">Enter your email to request access. If you’re approved, we’ll email your private download link.</div>
      <form class="hw-cap-form" novalidate onsubmit="submitDesktopAccessRequest(); return false;">
        <label class="hw-field-label" for="hw-email">Email address</label>
        <input
          class="hw-inp"
          id="hw-email"
          type="email"
          placeholder="you@example.com"
          autocomplete="email"
          inputmode="email"
          autocapitalize="off"
          autocorrect="off"
          required
        >
        <div class="mw-error" id="hw-error" aria-live="polite"></div>
        <button class="hw-submit" id="hw-submit" type="submit">Request access</button>
        <p class="hw-cap-sub hw-privacy">We’ll use your email only to manage beta access. <a href="/privacy">Read our Privacy Policy.</a></p>
        <p class="bp-link">
          <a href="#" id="hw-resend" onclick="resendHW(); return false;">Already approved? Resend my download link</a>
        </p>
      </form>
    </div>

    <div class="hw-done" id="hw-done" aria-live="polite">
      <div class="hw-done-msg">Request received</div>
      <div class="hw-done-sub">If this address is approved, we’ll email the private download link. If you’ve requested access before, there’s nothing else to do.</div>
    </div>
  </div>
</section>

<style>
  .wl-ui {
    justify-content: flex-end;
    padding: 32px 24px clamp(32px, 6vh, 60px);
  }

  .hw-capture {
    box-sizing: border-box;
    max-width: 460px;
    gap: 12px;
    padding: 26px 28px 24px;
    border: 1px solid rgba(29, 222, 200, 0.2);
    border-radius: 24px;
    background: rgba(6, 12, 20, 0.82);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(18px);
  }

  .hw-cap-label {
    font-size: clamp(28px, 3vw, 38px);
    font-style: normal;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .hw-cap-intro {
    max-width: 390px;
    color: rgba(240, 244, 248, 0.72);
    font-size: 14px;
    line-height: 1.55;
  }

  .hw-cap-form {
    gap: 11px;
  }

  .hw-field-label {
    color: rgba(240, 244, 248, 0.7);
    font-family: 'DM Sans Variable', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hw-submit {
    width: 100%;
    background: var(--teal-deck);
    color: #060c14;
  }

  .hw-submit:hover {
    background: var(--teal);
  }

  .hw-privacy {
    color: rgba(240, 244, 248, 0.58);
    font-size: 12px;
  }

  .hw-privacy a {
    color: var(--teal);
  }

  .hw-done {
    box-sizing: border-box;
    max-width: 520px;
    padding: 28px 32px;
    border: 1px solid rgba(29, 222, 200, 0.2);
    border-radius: 24px;
    background: rgba(6, 12, 20, 0.82);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(18px);
  }

  .hw-done-msg {
    font-style: normal;
  }

  .hw-done-sub {
    max-width: 440px;
    line-height: 1.55;
  }
</style>
