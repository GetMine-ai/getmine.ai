<!-- DESKTOP ACCESS REQUEST OVERLAY -->
<section
  id="waitlist"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="hw-title"
>
  <button class="wl-close" onclick="closeWaitlist()" aria-label="[COPY TBC]">×</button>
  <canvas id="wl-cv" width="1920" height="992" aria-hidden="true"></canvas>
  <div class="wl-ui">
    <div class="hw-label on" id="hw-label">[COPY TBC]</div>

    <div class="hw-capture active" id="hw-capture">
      <div class="hw-cap-label" id="hw-title">[COPY TBC]</div>
      <div class="hw-cap-sub">[COPY TBC]</div>
      <form class="hw-cap-form" onsubmit="submitDesktopAccessRequest(); return false;">
        <label class="hw-cap-sub" for="hw-email">[COPY TBC]</label>
        <input
          class="hw-inp"
          id="hw-email"
          type="email"
          placeholder="[COPY TBC]"
          autocomplete="email"
          inputmode="email"
          autocapitalize="off"
          autocorrect="off"
          required
        >
        <div class="mw-error" id="hw-error" aria-live="polite"></div>
        <button class="hw-submit" id="hw-submit" type="submit">[COPY TBC]</button>
        <p class="hw-cap-sub">[COPY TBC] <a href="/privacy">[COPY TBC]</a></p>
        <p class="bp-link">
          <a href="#" id="hw-resend" onclick="resendHW(); return false;">Already approved? Resend my download link</a>
        </p>
      </form>
    </div>

    <div class="hw-done" id="hw-done" aria-live="polite">
      <div class="hw-done-msg">[COPY TBC]</div>
      <div class="hw-done-sub">[COPY TBC]</div>
    </div>
  </div>
</section>
