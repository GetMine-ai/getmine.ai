---
const promises = [
  ['Your vault lives with you.', 'Local-first on your device.'],
  ['Your question defines the task.', 'You decide what leaves.'],
  ['You set the terms.', 'Revocable, always in view.'],
  ['Your vault is built to serve you.', 'Never to mine you.'],
];
---
<section id="our-promise" class="section-edge" aria-labelledby="our-promise-heading">
  <div class="wrap section-pad">
    <div class="section-heading">
      <p class="eyebrow">Our promise</p>
      <h2 id="our-promise-heading">
        Self-sovereignty
        <span>isn’t a feature.</span>
        <em>It’s an oath.</em>
      </h2>
      <p class="support">
        Too much. Too little. The wrong context. People are left to guess what to
        share.
      </p>
    </div>

    <ul class="promise-grid">
      {promises.map(([claim, beat]) => (
        <li>
          <h3>{claim} <strong>{beat}</strong></h3>
        </li>
      ))}
    </ul>

    <p class="signature">
      <span>Your health.</span> <strong>Your data.</strong> <em>Your rules.</em>
    </p>
  </div>
</section>

<style>
  section {
    position: relative;
    overflow: hidden;
    background: var(--navy);
  }

  .section-heading {
    max-width: none;
  }

  .section-heading h2 span {
    color: var(--teal);
    font-style: normal;
  }

  .support {
    max-width: 56rem;
    margin: 1.5rem 0 0;
    color: var(--cream);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .promise-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-12);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }

  .promise-grid li {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--teal-line);
  }

  .promise-grid h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.15vw, 1.75rem);
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.16;
  }

  .promise-grid h3 strong {
    display: block;
    color: var(--teal);
    font-weight: 300;
  }

  .signature {
    margin: 4.75rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .signature span {
    color: var(--cream);
  }

  .signature strong {
    color: var(--teal);
    font-weight: 300;
  }

  .signature em {
    color: var(--taupe);
    font-style: normal;
  }

  @media (max-width: 47.99rem) {
    .promise-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
