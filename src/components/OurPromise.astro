---
const promises = [
  ['Your vault lives with you.', 'Local-first on your device.', 'I’m a builder, not a keeper.'],
  ['Your question defines the task.', 'You decide what leaves.', 'I prepare only the context the task needs, never the whole record.'],
  ['You set the terms.', 'Revocable, always in view.', 'You decide. I execute.'],
  ['Built to serve you.', 'Not to mine you.', 'I have one side. Yours.'],
];
---
<section id="our-promise" class="section-edge" aria-labelledby="our-promise-heading">
  <div class="wrap section-pad">
    <div class="promise-head">
      <div class="section-heading">
        <p class="eyebrow">Our promise</p>
        <h2 id="our-promise-heading">
          Self-sovereignty isn’t a feature.
          <span>It’s an oath.</span>
        </h2>
        <p class="support">
          Too much. Too little. The wrong context. People are left to guess what to
          share. Mina identifies what the task needs, your vault stays yours, and you
          decide what leaves.
        </p>
      </div>
      <div class="mina-oath">
        <span class="mina-mark" role="img" aria-label="Mina"><i>M</i><b>.</b></span>
        <p>How Mina keeps the oath.</p>
      </div>
    </div>

    <ul class="promise-grid">
      {promises.map(([claim, beat, implication]) => (
        <li>
          <div class="card claim"><p>{claim} <strong>{beat}</strong></p></div>
          <div class="card response"><p>“{implication}”</p></div>
        </li>
      ))}
    </ul>

    <p class="signature">
      <span>Your health.</span> <strong>Your data.</strong> <em>Your rules.</em>
    </p>
  </div>
</section>

<style>
  section {
    position: relative;
    overflow: hidden;
    background: var(--navy);
  }

  .promise-head {
    display: grid;
    gap: 2.5rem;
  }

  .section-heading h2 span {
    color: var(--teal);
    font-style: italic;
  }

  .support {
    max-width: 42.5rem;
    margin: 1.5rem 0 0;
    color: var(--text-secondary);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .mina-oath {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
  }

  .mina-mark {
    position: relative;
    display: inline-flex;
    width: 5rem;
    height: 5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--teal-line);
    border-radius: 50%;
    background: var(--navy-2);
    box-shadow: 0 0 4rem rgb(29 191 176 / 20%);
    font-family: var(--font-display);
    font-size: 2.2rem;
  }

  .mina-mark i {
    font-style: italic;
    font-weight: 300;
  }

  .mina-mark b {
    color: var(--teal);
    font-weight: 300;
  }

  .mina-oath p {
    margin: 0;
    color: var(--taupe);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.375rem);
    font-style: italic;
  }

  .promise-grid {
    display: grid;
    gap: 1rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .promise-grid li {
    display: grid;
    gap: 1rem;
  }

  .promise-grid .card {
    display: flex;
    min-height: 6.75rem;
    align-items: center;
    padding: 1.25rem 1.5rem;
  }

  .promise-grid p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    font-weight: 300;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .claim strong {
    color: var(--teal);
    font-weight: 300;
  }

  .response {
    border-color: var(--teal-line);
    background: var(--teal-surface);
  }

  .response p {
    font-style: italic;
  }

  .signature {
    margin: 3.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .signature strong {
    color: var(--teal);
    font-weight: 300;
  }

  .signature em {
    color: var(--taupe);
    font-style: normal;
  }

  @media (min-width: 64rem) {
    .promise-head {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3rem;
    }

    .mina-oath {
      display: flex;
    }

    .promise-grid li {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }
</style>
