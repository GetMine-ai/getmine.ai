<!-- MOBILE ACCESS REQUEST -->
<section
  id="mobile-waitlist"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="mw-title"
>
  <header class="mw-nav">
    <div class="nav-logo">Get<span class="logo-mine">Mine.</span><span class="logo-ai">ai</span></div>
    <button class="mw-close" onclick="closeMobileWaitlist()" aria-label="Close beta access request">×</button>
  </header>

  <div class="mw-stage mw-stage-form active" id="mw-stage-form">
    <p class="mw-eyebrow">GetMine open beta</p>
    <h2 class="mw-h" id="mw-title">Join the open beta</h2>
    <p class="mw-sub">Join the waiting list &mdash; confirm your email, and your invitation arrives when your wave opens.</p>

    <form class="mw-form" novalidate onsubmit="submitMobileWaitlist(); return false;">
      <label class="mw-field" for="mw-email">
        <span class="mw-label">Email address</span>
      </label>
      <input
        class="mw-inp"
        id="mw-email"
        type="email"
        autocomplete="email"
        inputmode="email"
        autocapitalize="off"
        autocorrect="off"
        placeholder="you@example.com"
        required
      >
      <div class="mw-error" id="mw-error" aria-live="polite"></div>
      <button class="mw-submit" type="submit" id="mw-submit">Join the waiting list</button>
      <p class="mw-trust mw-requirement">GetMine needs a computer running macOS&nbsp;14 or later, or Windows&nbsp;11 &mdash; apply now, and install on your computer when your invitation arrives.</p>
      <p class="mw-trust">We’ll use your email only to manage beta access. <a href="/privacy">Read our Privacy Policy.</a></p>
    </form>
  </div>

  <div class="mw-stage mw-stage-done" id="mw-stage-done" aria-live="polite">
    <div class="mw-tick" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="14" stroke="#1DDEC8" stroke-width="2"/>
        <path d="M9 16 l5 5 9-9" stroke="#1DDEC8" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <p class="mw-eyebrow">GetMine open beta</p>
    <h2 class="mw-h">Almost there</h2>
    <p class="mw-sub">Check your inbox and click the confirmation link to join the waiting list. Not there? Have a look in your junk folder.</p>
    <button class="mw-submit mw-submit-ghost" onclick="closeMobileWaitlist()">Back to GetMine</button>
  </div>
</section>

<style>
  .mw-stage {
    padding-top: clamp(52px, 10vh, 88px);
  }

  .mw-stage-form {
    box-sizing: border-box;
  }

  .mw-h {
    font-style: normal;
  }

  .mw-sub {
    max-width: 360px;
  }

  .mw-form {
    box-sizing: border-box;
    padding: 22px;
    border: 1px solid rgba(29, 222, 200, 0.18);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.025);
  }

  .mw-submit:not(.mw-submit-ghost) {
    background: var(--teal-deck);
    color: #060c14;
  }

  .mw-trust a {
    color: var(--teal);
  }

  .mw-stage-done {
    max-width: 420px;
  }
</style>
