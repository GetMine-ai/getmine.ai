<!-- MOBILE ACCESS REQUEST -->
<section
  id="mobile-waitlist"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="mw-title"
>
  <header class="mw-nav">
    <div class="nav-logo">Get<span class="logo-mine">Mine.</span><span class="logo-ai">ai</span></div>
    <button class="mw-close" onclick="closeMobileWaitlist()" aria-label="[COPY TBC]">×</button>
  </header>

  <div class="mw-stage mw-stage-form active" id="mw-stage-form">
    <p class="mw-eyebrow">[COPY TBC]</p>
    <h2 class="mw-h" id="mw-title">[COPY TBC]</h2>
    <p class="mw-sub">[COPY TBC]</p>

    <form class="mw-form" onsubmit="submitMobileWaitlist(); return false;">
      <label class="mw-field" for="mw-email">
        <span class="mw-label">[COPY TBC]</span>
      </label>
      <input
        class="mw-inp"
        id="mw-email"
        type="email"
        autocomplete="email"
        inputmode="email"
        autocapitalize="off"
        autocorrect="off"
        placeholder="[COPY TBC]"
        required
      >
      <div class="mw-error" id="mw-error" aria-live="polite"></div>
      <button class="mw-submit" type="submit" id="mw-submit">[COPY TBC]</button>
      <p class="mw-trust">[COPY TBC] <a href="/privacy">[COPY TBC]</a></p>
      <p class="bp-link">
        <a href="#" id="mw-resend" onclick="resendMobileWaitlist(); return false;">Already approved? Resend my download link</a>
      </p>
    </form>
  </div>

  <div class="mw-stage mw-stage-done" id="mw-stage-done" aria-live="polite">
    <div class="mw-tick" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="14" stroke="#1DDEC8" stroke-width="2"/>
        <path d="M9 16 l5 5 9-9" stroke="#1DDEC8" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <p class="mw-eyebrow">[COPY TBC]</p>
    <h2 class="mw-h">[COPY TBC]</h2>
    <p class="mw-sub">[COPY TBC]</p>
    <button class="mw-submit mw-submit-ghost" onclick="closeMobileWaitlist()">[COPY TBC]</button>
  </div>
</section>
