<!-- ─── MOBILE WAITLIST ──────────────────────────────────────────────
Lightweight, single-screen waitlist form shown on narrow viewports
(≤880px) instead of the elaborate CTA overlay. No canvas animations,
no multi-step flow, native iOS keyboard support, instant POST.
Hooked up by openWaitlist() in main.ts, which routes to whichever
overlay matches the viewport. -->
<section id="mobile-waitlist" aria-hidden="true">
  <header class="mw-nav">
    <div class="nav-logo">Get<span class="logo-mine">Mine.</span><span class="logo-ai">ai</span></div>
    <button class="mw-close" onclick="closeMobileWaitlist()" aria-label="Close">×</button>
  </header>

  <div class="mw-stage mw-stage-form" id="mw-stage-form">
    <p class="mw-eyebrow">Early access</p>
    <h2 class="mw-h">Join the <em>waiting list</em></h2>
    <p class="mw-sub">We'll reach out personally when we're ready for you.</p>

    <form class="mw-form" onsubmit="event.preventDefault(); submitMobileWaitlist();">
      <label class="mw-field">
        <span class="mw-label">Full name</span>
        <input class="mw-inp" id="mw-name" type="text" autocomplete="name"
               inputmode="text" placeholder="Sabine Azancot" required>
      </label>
      <label class="mw-field">
        <span class="mw-label">Email</span>
        <input class="mw-inp" id="mw-email" type="email" autocomplete="email"
               inputmode="email" autocapitalize="off" autocorrect="off"
               placeholder="you@email.com" required>
      </label>
      <label class="mw-field">
        <span class="mw-label">Mobile <span class="mw-opt">(optional)</span></span>
        <input class="mw-inp" id="mw-phone" type="tel" autocomplete="tel"
               inputmode="tel" placeholder="+44 7700 000000">
      </label>
      <div class="mw-error" id="mw-error"></div>
      <button class="mw-submit" type="submit" id="mw-submit">Reserve my spot →</button>
      <p class="mw-trust">Private. No spam. We'll only email you about your access.</p>
    </form>
  </div>

  <div class="mw-stage mw-stage-done" id="mw-stage-done">
    <div class="mw-tick" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="14" stroke="#1DDEC8" stroke-width="2"/>
        <path d="M9 16 l5 5 9-9" stroke="#1DDEC8" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <p class="mw-eyebrow">You're on the list</p>
    <h2 class="mw-h">Thank you<span id="mw-done-name">.</span></h2>
    <p class="mw-sub">We've got your details. We will reach out as soon as we're ready for you.</p>
    <button class="mw-submit mw-submit-ghost" onclick="closeMobileWaitlist()">Back to GetMine</button>
  </div>
</section>
