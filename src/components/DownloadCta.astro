---
// Lifeline bars: a fixed, decorative row (same motif as the social banners).
const palette = ['#4a7de0', '#4a7de0', '#4a7de0', '#1dbfb0', '#1dbfb0', '#5a8f2f'];
let seed = 630;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const bars: { x: number; h: number; c: string }[] = [];
for (let x = 12; x < 1188; x += [20, 24, 28, 32, 36][Math.floor(rand() * 5)]) {
  const tier = Math.floor(rand() * 4);
  const h = tier < 2 ? 10 + rand() * 16 : tier === 2 ? 24 + rand() * 22 : 42 + rand() * 26;
  bars.push({ x, h: Math.round(h), c: palette[Math.floor(rand() * palette.length)] });
}
---
<section class="download-cta section-edge" aria-labelledby="download-cta-title" data-site-section="closing">
  <div class="wrap">
    <p class="eyebrow">Open beta · Free to download</p>
    <h2 id="download-cta-title"><span>Your health.</span> <em>Your data.</em> <span class="rules">Your rules.</span></h2>
    <p>Start your vault on your own computer, with Mina included.</p>
    <a class="primary-cta" href="/beta">Download GetMine</a>
  </div>
  <svg class="lifeline" viewBox="0 0 1200 84" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
    {bars.map((b) => (
      <g>
        <rect x={b.x} y={82 - b.h} width="2.5" height={b.h} rx="1.2" fill={b.c} opacity="0.45" />
        <circle cx={b.x + 1.25} cy={82 - b.h} r="4.5" fill={b.c} opacity="0.65" />
      </g>
    ))}
    <rect x="0" y="82" width="1200" height="1.5" fill="rgb(232 250 248 / 14%)" />
  </svg>
</section>

<style>
  .download-cta {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    text-align: center;
  }

  .lifeline {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: max(3.5rem, 7vw);
    pointer-events: none;
  }

  .download-cta .wrap {
    display: grid;
    justify-items: center;
    position: relative;
    padding-block: clamp(4rem, 8vw, 7rem) max(6.5rem, calc(7vw + 3rem));
  }

  h2 {
    max-width: 52rem;
    margin: 1rem 0 0;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 300;
    line-height: 1.08;
    text-wrap: balance;
  }

  h2 > span,
  h2 em {
    display: block;
  }

  h2 em {
    color: var(--teal);
    font-style: normal;
  }

  .download-cta #download-cta-title .rules {
    color: var(--taupe);
  }

  p:not(.eyebrow) {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    color: var(--cream);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .primary-cta {
    margin-top: 2rem;
  }
</style>
