<!-- WHY IT MATTERS (was: Problem) -->
<section id="why-it-matters">
  <div class="why-inner reveal-stagger">
    <p class="why-eyebrow">Why it matters</p>
    <h2 class="why-headline">Life happens. <span class="beat-teal">Your health history</span> <span class="beat-taupe">fails you when you need it most.</span></h2>

    <div class="why-cards">
      <article class="why-card">
        <p class="why-card-label">The family caregiver</p>
        <img src="/assets/family-caregiver.jpg" alt="A family caregiver helping a relative manage medication">
        <h3>You become the memory.</h3>
        <p class="why-card-subtitle">Caring for family</p>
      </article>
      <article class="why-card">
        <p class="why-card-label">The chronic condition loop</p>
        <img src="/assets/chronic-condition-loop.jpg" alt="A person managing health documents and appointments">
        <h3>You repeat your story.</h3>
        <p class="why-card-subtitle">Managing a condition</p>
      </article>
      <article class="why-card">
        <p class="why-card-label">The life transition</p>
        <img src="/assets/life-transition-moment.jpg" alt="A person navigating healthcare during a life transition">
        <h3>You lose the thread.</h3>
        <p class="why-card-subtitle">Your health history in urgent moments</p>
      </article>
    </div>

    <div class="why-frictions">
      <p class="why-frictions-title">The daily frictions we all face.</p>
      <div class="why-frictions-scroll">
        <div class="why-friction"><strong>What?</strong><span>What was that test result?</span></div>
        <div class="why-friction"><strong>When?</strong><span>When did I have that vaccine?</span></div>
        <div class="why-friction"><strong>How?</strong><span>What dosage was I taking?</span></div>
        <div class="why-friction"><strong>Who?</strong><span>Who did I see for this?</span></div>
        <div class="why-friction"><strong>Where?</strong><span>Where is that report?</span></div>
        <div class="why-friction"><strong>Share?</strong><span>What should I share?</span></div>
      </div>
    </div>
  </div>
</section>
