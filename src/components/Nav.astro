---
import InviteFriend from './InviteFriend.astro';

interface Props {
  hideCta?: boolean;
}

const { hideCta = false } = Astro.props;
const nav = [
  ['Why it matters', 'why-it-matters'],
  ['How it works', 'how-it-works'],
  ['Our promise', 'our-promise'],
  ['About us', 'about-us'],
];
---
<header class="site-header" data-site-header>
  <div class="nav-wrap wrap-wide">
    <div class="nav-left">
      <a class="wordmark" href="/#top" aria-label="GetMine.ai home">
        <span>Get</span><em>Mine.</em><span>ai</span>
      </a>
      <nav class="desktop-nav" aria-label="Primary">
        {nav.map(([label, id]) => (
          <a href={`/#${id}`} data-nav-link={id}>{label}<span aria-hidden="true"></span></a>
        ))}
      </nav>
    </div>

    <div class="nav-actions">
      {!hideCta && (
        <InviteFriend
          variant="compact"
          placement="menubar"
          instanceId="menubar"
          conditional
        />
      )}
      {!hideCta && (
        <a class="primary-cta desktop-action header-cta" href="/beta" data-header-cta>Request beta access</a>
      )}
      <button
        class="menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="Open menu"
        data-menu-button
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-navigation" class="mobile-menu" aria-hidden="true" data-mobile-menu inert>
    <nav class="wrap" aria-label="Mobile">
      {nav.map(([label, id]) => <a href={`/#${id}`} data-menu-link>{label}</a>)}
      {!hideCta && <a class="primary-cta" href="/beta">Request beta access</a>}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid rgb(232 250 248 / 5%);
    background: transparent;
    transition:
      background 260ms var(--ease-gm),
      border-color 260ms var(--ease-gm),
      backdrop-filter 260ms var(--ease-gm);
  }

  .site-header.scrolled {
    border-color: var(--line-quiet);
    background: rgb(6 12 20 / 85%);
    backdrop-filter: blur(20px);
  }

  .nav-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.75rem;
  }

  .nav-left,
  .nav-actions,
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-left {
    width: 100%;
    flex: 1 1 auto;
    min-width: 0;
    gap: 2rem;
  }

  .nav-actions {
    flex-shrink: 0;
    gap: 0.75rem;
  }

  .wordmark {
    flex-shrink: 0;
    border-radius: 0.375rem;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: -0.025em;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark em {
    color: var(--teal);
    font-style: italic;
  }

  .desktop-nav {
    display: none;
    gap: 1.75rem;
    margin-left: auto;
  }

  .desktop-nav a {
    position: relative;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    transition: color 180ms;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="true"] {
    color: var(--teal);
  }

  .desktop-nav a > span {
    position: absolute;
    right: 0;
    bottom: -0.4rem;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--teal);
    transition: transform 260ms var(--ease-gm);
  }

  .desktop-nav a[aria-current="true"] > span {
    transform: scaleX(1);
  }

  .desktop-action {
    display: none;
  }

  .header-cta {
    max-width: 0;
    min-width: 0;
    overflow: hidden;
    padding-right: 0;
    padding-left: 0;
    white-space: nowrap;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      max-width 300ms var(--ease-gm),
      padding 300ms var(--ease-gm),
      opacity 260ms var(--ease-gm),
      transform 180ms var(--ease-gm),
      visibility 0s linear 260ms;
  }

  .header-cta.visible {
    max-width: 13rem;
    padding-right: 1.5rem;
    padding-left: 1.5rem;
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .menu-button {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.32rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--cream);
    cursor: pointer;
  }

  .menu-button span {
    width: 1.25rem;
    height: 1px;
    background: currentColor;
    transition:
      transform 180ms,
      opacity 180ms;
  }

  .menu-button[aria-expanded="true"] span:first-child {
    transform: translateY(0.375rem) rotate(45deg);
  }

  .menu-button[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .menu-button[aria-expanded="true"] span:last-child {
    transform: translateY(-0.375rem) rotate(-45deg);
  }

  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    border-top: 0 solid var(--line-quiet);
    background: rgb(6 12 20 / 96%);
    backdrop-filter: blur(20px);
    transition:
      grid-template-rows 260ms var(--ease-gm),
      border-width 260ms;
  }

  .mobile-menu.open {
    grid-template-rows: 1fr;
    border-top-width: 1px;
  }

  .mobile-menu nav {
    display: flex;
    min-height: 0;
    flex-direction: column;
    gap: 0.25rem;
    overflow: hidden;
    padding-block: 1rem;
  }

  .mobile-menu a:not(.primary-cta) {
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 300;
    text-decoration: none;
  }

  .mobile-menu a:not(.primary-cta):hover {
    background: var(--surface);
    color: var(--teal);
  }

  .mobile-menu .primary-cta {
    width: 100%;
    margin-top: 0.75rem;
  }

  @media (min-width: 40rem) {
    .desktop-action {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    .desktop-nav {
      display: flex;
    }

    .menu-button,
    .mobile-menu {
      display: none;
    }
  }
</style>
