---
import LegalPage from '../layouts/LegalPage.astro';
// Document 09 of the regulatory pack. THE PACK IS CANONICAL and this page
// renders src/data/regulatory.ts, which mirrors it. Never write copy here.
import { trustPage } from '../data/regulatory';
---
<LegalPage title="Trust &amp; security | GetMine.ai" description="How GetMine approaches security today, what we are building toward, and what we do not yet claim." canonical="https://getmine.ai/trust">
    <p class="page-eyebrow">{trustPage.eyebrow}</p>
    <h1 class="page-headline">{trustPage.title}</h1>

    <aside class="policy-summary"><strong>The short version:</strong> {trustPage.summary.replace('The short version: ', '')}</aside>

    <p class="page-lead">{trustPage.lead}</p>

    {trustPage.sections.map((section) => (
      <div class="page-section">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {'bullets' in section && (
          <ul>
            {section.bullets.map((bullet) => {
              const cut = bullet.indexOf('. ') + 1;
              return <li><strong>{bullet.slice(0, cut)}</strong> {bullet.slice(cut + 1)}</li>;
            })}
          </ul>
        )}
      </div>
    ))}

    <div class="page-section">
      <h2>{trustPage.questions.heading}</h2>
      {trustPage.questions.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p>The <a href="/privacy">privacy policy</a> is the governing statement; where the two could be read differently, the privacy policy prevails.</p>
    </div>

    <p class="page-lead" style="font-size:.85em;opacity:.75">Last updated: {trustPage.published} &middot; GetMine Ltd &middot; security@getmine.ai</p>
</LegalPage>

<style>
  .policy-summary {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--teal-deck);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--teal-deck) 9%, transparent);
    color: var(--cream);
    font-size: clamp(1.0625rem, 1.8vw, 1.1875rem);
    line-height: 1.65;
  }

  .page-section ul {
    margin: 1rem 0 0;
    padding-left: 1.25rem;
  }

  .page-section li {
    margin-top: 0.75rem;
    line-height: 1.65;
  }
</style>
