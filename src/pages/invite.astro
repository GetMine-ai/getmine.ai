---
import { whatsappLink } from '../data/whatsapp';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#060c14">
  <meta name="description" content="Meet Mina, your personal health companion. Start your health vault with a conversation.">
  <meta name="robots" content="noindex,nofollow">
  <title>Meet Mina · Your health. Your data. Your rules.</title>
  <link rel="icon" type="image/svg+xml" href="/invite-assets/mina.svg">
  <link rel="preload" href="/invite-assets/fraunces.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/invite-assets/fraunces-italic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/invite-assets/dm-sans.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/invite-assets/style.css">
<meta property="og:title" content="You’re invited to meet Mina">
<meta property="og:description" content="A private invitation from a GetMine member. Text Mina on WhatsApp to get started.">
<meta property="og:image" content="https://getmine.ai/invite-assets/link-preview.png">
<meta property="og:type" content="website"><meta property="og:site_name" content="getmine.ai">
</head>
<body>
  <a class="skip" href="#meet-mina">Skip to Mina</a>
  <div class="page">
    <header>
      <a class="wordmark" href="https://getmine.ai/" aria-label="GetMine.ai"><span>Get</span><em>Mine.</em><span>ai</span></a>
    </header>

    <main id="meet-mina" class="invite">
      <span class="mina-mark big" role="img" aria-label="Mina"><i>M</i><b>.</b></span>
      <p class="welcome">Welcome.</p>
      <h1><span>You’re invited</span> to meet Mina.</h1>
      <p class="story">Your personal health companion. She gathers your health records, files and what you tell her into one vault on your own computer.</p>
      <div class="actions">
        <a class="primary" id="text-mina" href={whatsappLink('Hi Mina, I was invited.')}>Text Mina on WhatsApp</a>
      </div>
      <p class="cta-note">Opens WhatsApp with “Hi Mina, I was invited.” ready to send.</p>
    </main>

    <footer>
      <p class="brand-promise"><span>Your health.</span> <span>Your data.</span> <span>Your rules.</span></p>
      <nav aria-label="Footer"><a href="https://getmine.ai/privacy">Privacy</a><a href="https://getmine.ai/terms">Terms</a><a href="https://getmine.ai/trust">Trust &amp; Security</a></nav>
    </footer>
  </div>

  <dialog id="entry-dialog" aria-labelledby="dialog-title" aria-describedby="dialog-copy">
    <button class="close" type="button" aria-label="Close WhatsApp options"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg></button>
    <span class="mina-mark small" aria-hidden="true"><i>M</i><b>.</b></span>
    <h2 id="dialog-title">Text Mina on WhatsApp.</h2>
    <p class="dialog-copy" id="dialog-copy">Scan with your phone’s camera to open Mina’s chat.</p>
    <div class="qr-frame" role="img" aria-label="Scan to open Mina’s WhatsApp chat"></div>
    <p class="or" aria-hidden="true"><span>or</span></p>
    <a class="dialog-secondary" href={whatsappLink('Hi Mina, I was invited.')} target="_blank" rel="noopener noreferrer">Open WhatsApp on this computer</a>
    <p class="prototype-note">“Hi Mina, I was invited.” will be ready for you to send.<br>Send it, and I’ll reply.</p>
  </dialog>
  <script is:inline src="/invite-assets/qrcode.js"></script><script is:inline src="/invite-assets/qrcode_UTF8.js"></script><script is:inline src="/invite-assets/script.js"></script>
</body>
</html>
