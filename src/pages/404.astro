---
// Astro always emits dist/404.html so GitHub Pages can serve this route.
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found | GetMine.ai"
  description="The page you followed might be broken or may have moved."
  canonical="https://getmine.ai/404.html"
>
  <div class="not-found">
    <nav>
      <a href="/" class="nav-logo" aria-label="GetMine.ai home">
        Get<span>Mine.</span><i>ai</i>
      </a>
    </nav>

    <main>
      <div class="code" aria-hidden="true">404</div>
      <h1>This page is <em>off the map.</em></h1>
      <p>
        The link you followed might be broken, or the page may have moved. Either way, we’ll get you
        back on track.
      </p>
      <div class="cta-row">
        <a href="/" class="primary">Take me home →</a>
        <a href="mailto:hello@getmine.ai" class="secondary">Get in touch</a>
      </div>
    </main>

    <footer>
      <span>© 2026 GetMine Ltd</span>
      <span aria-hidden="true">·</span>
      <a href="mailto:hello@getmine.ai">hello@getmine.ai</a>
    </footer>
  </div>
</Base>

<style>
  .not-found {
    position: relative;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    overflow: hidden;
    background: var(--navy);
    color: var(--cream);
  }

  .not-found::before {
    position: fixed;
    z-index: 0;
    inset: 0;
    background: radial-gradient(ellipse at center, rgb(29 191 176 / 10%) 0%, transparent 60%);
    content: '';
    pointer-events: none;
  }

  nav {
    position: relative;
    z-index: 1;
    display: flex;
    height: 5rem;
    align-items: center;
    padding: 1.375rem 2.25rem;
  }

  .nav-logo {
    display: inline-flex;
    align-items: baseline;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 300;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav-logo span,
  .nav-logo i {
    color: var(--teal);
    font-style: italic;
  }

  .nav-logo i {
    color: var(--cream);
  }

  main {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3.75rem 2rem;
    text-align: center;
  }

  .code {
    margin-bottom: 0.5rem;
    color: var(--teal);
    font-family: var(--font-display);
    font-size: clamp(7.5rem, 22vw, 13.75rem);
    font-style: italic;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1;
    opacity: 0.95;
  }

  h1 {
    max-width: 40rem;
    margin: 0 0 1.25rem;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  h1 em {
    color: var(--taupe);
    font-style: italic;
  }

  main p {
    max-width: 30rem;
    margin: 0 0 2.25rem;
    color: var(--text-secondary);
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: 300;
    line-height: 1.6;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .cta-row a {
    border-radius: var(--radius-pill);
    padding: 0.875rem 2rem;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
    transition:
      color var(--ease-fast),
      border-color var(--ease-fast),
      background var(--ease-fast),
      transform var(--ease-fast);
  }

  .primary {
    background: var(--cream);
    color: var(--navy);
  }

  .secondary {
    border: 1px solid var(--line);
    color: var(--cream);
  }

  .cta-row a:hover,
  .cta-row a:focus-visible {
    transform: translateY(-2px);
  }

  .secondary:hover,
  .secondary:focus-visible {
    border-color: var(--teal-line);
    background: rgb(255 255 255 / 5%);
  }

  footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    border-top: 1px solid var(--line-quiet);
    padding: 2rem;
    color: var(--text-quiet);
    font-size: 12px;
    text-align: center;
  }

  footer a {
    color: var(--teal);
    text-decoration: none;
  }

  @media (max-width: 37.5rem) {
    nav {
      height: 4rem;
      padding: 1.125rem 1.5rem;
    }

    main {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
